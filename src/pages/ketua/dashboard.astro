---
import '../../global.css';

const GOOGLE_API_URL = import.meta.env.PUBLIC_SECRET_SHEETS_API_URL;
const ketuaNama = Astro.url.searchParams.get('nama') || 'Ketua';
const ketuaKelompok = Astro.url.searchParams.get('kelompok') || '';
---

<!DOCTYPE html>
<html lang="id" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Ketua - {ketuaKelompok} | MM Tandes Barat</title>

  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="MM Tandes" />
  <link rel="apple-touch-icon" href="/pwa-192x192.png" />

  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline>
    tailwind.config = { darkMode: 'class' }
    const savedTheme = localStorage.getItem('theme') || 'dark';
    if (savedTheme === 'light') document.documentElement.classList.remove('dark');
    else document.documentElement.classList.add('dark');
  </script>
</head>
<body class="bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-slate-100 min-h-screen p-4 transition-colors duration-300">

  <div class="max-w-6xl mx-auto" id="ketuaDashboard" data-api={GOOGLE_API_URL} data-kelompok={ketuaKelompok} data-nama={ketuaNama}>

    <!-- Header -->
    <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 pb-5 mb-6 border-b border-slate-200 dark:border-slate-800">
      <div>
        <h1 class="text-xl md:text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Dashboard <span class="text-amber-600 dark:text-amber-400">Ketua Kelompok</span></h1>
        <p class="text-xs text-slate-500 dark:text-slate-400">Kelompok: <b class="text-amber-600 dark:text-amber-400">{ketuaKelompok}</b> | Halo, {ketuaNama}</p>
      </div>
      <div class="flex items-center gap-2">
        <button id="themeToggleBtn" class="w-10 h-10 flex items-center justify-center rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-lg hover:bg-slate-100 dark:hover:bg-slate-800 shadow-sm transition-all">🌙</button>
        <a href="/" class="px-4 py-2 bg-rose-500 hover:bg-rose-600 text-white text-xs font-semibold rounded-xl shadow-md transition-all">Keluar</a>
      </div>
    </header>

    <!-- Stats Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
      <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-4 rounded-2xl shadow-sm">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Total Anggota</div>
        <div id="statTotalAnggota" class="text-2xl md:text-3xl font-extrabold text-slate-900 dark:text-white">-</div>
      </div>
      <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-4 rounded-2xl shadow-sm relative overflow-hidden">
        <div class="absolute left-0 top-0 h-full w-1 bg-emerald-500"></div>
        <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Hadir Hari Ini</div>
        <div id="statHadir" class="text-2xl md:text-3xl font-extrabold text-emerald-600 dark:text-emerald-400">-</div>
      </div>
      <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-4 rounded-2xl shadow-sm relative overflow-hidden">
        <div class="absolute left-0 top-0 h-full w-1 bg-amber-500"></div>
        <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Izin</div>
        <div id="statIzin" class="text-2xl md:text-3xl font-extrabold text-amber-600 dark:text-amber-400">-</div>
      </div>
      <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-4 rounded-2xl shadow-sm relative overflow-hidden">
        <div class="absolute left-0 top-0 h-full w-1 bg-blue-500"></div>
        <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Kehadiran</div>
        <div id="statPersen" class="text-2xl md:text-3xl font-extrabold text-blue-600 dark:text-blue-400">-</div>
      </div>
    </div>

    <!-- Search Bar -->
    <div class="mb-6">
      <div class="relative">
        <input 
          type="text" 
          id="searchInput" 
          placeholder="🔍 Cari nama anggota..." 
          class="w-full p-4 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl text-sm outline-none focus:ring-2 focus:ring-amber-500 shadow-sm"
        />
        <div id="searchResultCount" class="absolute right-4 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400 hidden"></div>
      </div>
      <div id="searchInfo" class="mt-2 text-xs text-slate-500 hidden">
        Menampilkan <span id="searchShowing" class="font-bold text-amber-600"></span> dari <span id="searchTotal" class="font-bold"></span> anggota
      </div>
    </div>

    <!-- Tabel Anggota -->
    <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl shadow-sm overflow-hidden">
      <div class="p-4 border-b border-slate-200 dark:border-slate-700 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="border-l-4 border-amber-500 pl-3">
          <h2 class="text-sm font-bold text-slate-900 dark:text-white">Daftar Anggota {ketuaKelompok}</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400">Kelola data anggota kelompok Anda</p>
        </div>
        <button id="btnRefresh" class="px-3 py-1.5 bg-slate-200 dark:bg-slate-700 hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-300 text-xs font-bold rounded-lg transition-all flex items-center gap-1">
          🔄 Refresh
        </button>
      </div>
      
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-slate-100 dark:bg-slate-900 text-slate-500 dark:text-slate-400 text-xs font-bold uppercase">
            <tr>
              <th class="p-3 text-left">No</th>
              <th class="p-3 text-left">ID</th>
              <th class="p-3 text-left">Nama</th>
              <th class="p-3 text-left">Gender</th>
              <th class="p-3 text-center">Status</th>
              <th class="p-3 text-right">Total Hadir</th>
              <th class="p-3 text-center">Aksi</th>
            </tr>
          </thead>
          <tbody id="tabelAnggota" class="divide-y divide-slate-200 dark:divide-slate-700">
            <tr>
              <td colspan="7" class="p-8 text-center text-slate-400">Memuat data...</td>
            </tr>
          </tbody>
        </table>
      </div>
      
      <!-- Empty State -->
      <div id="emptyState" class="hidden p-8 text-center">
        <div class="text-4xl mb-2">🔍</div>
        <p class="text-sm text-slate-500">Tidak ada anggota yang cocok dengan pencarian</p>
      </div>
    </div>

  </div>

  <!-- Modal Edit User -->
  <div id="modalEditUser" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 rounded-2xl p-6 max-w-md w-full shadow-2xl border border-slate-200 dark:border-slate-700">
      <h3 class="text-base font-bold mb-1 text-slate-900 dark:text-white">Edit Data Anggota</h3>
      <p class="text-xs text-slate-500 mb-4">Update informasi anggota kelompok</p>
      
      <input type="hidden" id="editUserId">
      
      <div class="space-y-3">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Nama Lengkap</label>
          <input type="text" id="editNama" placeholder="Nama anggota"
            class="w-full p-3 bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl text-sm outline-none focus:ring-2 focus:ring-amber-500"/>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Gender</label>
          <select id="editGender" class="w-full p-3 bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl text-sm outline-none">
            <option value="Laki-laki">Laki-laki</option>
            <option value="Perempuan">Perempuan</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Kelompok</label>
          <select id="editKelompok" class="w-full p-3 bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl text-sm outline-none">
            <option value="Manukan 1">Manukan 1</option>
            <option value="Manukan 2">Manukan 2</option>
            <option value="Candi Lontar">Candi Lontar</option>
            <option value="Wonorejo">Wonorejo</option>
          </select>
        </div>
      </div>
      
      <div class="flex gap-2 mt-5">
        <button id="btnBatalEdit" class="flex-1 py-2.5 bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-sm font-bold rounded-xl">Batal</button>
        <button id="btnSimpanEdit" class="flex-1 py-2.5 bg-amber-500 hover:bg-amber-600 text-white text-sm font-bold rounded-xl">Simpan</button>
      </div>
    </div>
  </div>

  <!-- Modal Konfirmasi Hapus -->
  <div id="modalHapus" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 rounded-2xl p-6 max-w-sm w-full shadow-2xl border border-slate-200 dark:border-slate-700 text-center">
      <div class="w-12 h-12 bg-rose-500/10 rounded-full flex items-center justify-center mx-auto mb-3">
        <span class="text-rose-500 text-xl font-bold">!</span>
      </div>
      <h3 class="text-base font-bold text-slate-900 dark:text-white mb-1">Hapus Anggota?</h3>
      <p id="hapusDesc" class="text-xs text-slate-500 mb-5">Data anggota akan dihapus permanen dari database.</p>
      <div class="flex gap-2">
        <button id="btnBatalHapus" class="flex-1 py-2.5 bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-sm font-bold rounded-xl">Batal</button>
        <button id="btnKonfirmasiHapus" class="flex-1 py-2.5 bg-rose-500 hover:bg-rose-600 text-white text-sm font-bold rounded-xl">Hapus</button>
      </div>
    </div>
  </div>

  <script is:inline>
    const API_URL = document.getElementById('ketuaDashboard')?.getAttribute('data-api') || '';
    const NAMA_KETUA = document.getElementById('ketuaDashboard')?.getAttribute('data-nama') || '';
    const KELOMPOK_KETUA = document.getElementById('ketuaDashboard')?.getAttribute('data-kelompok') || '';

    let allMembers = [];
    let filteredMembers = [];

    // Theme Toggle
    const htmlEl = document.documentElement;
    const themeBtn = document.getElementById('themeToggleBtn');
    if (themeBtn) {
      themeBtn.innerText = htmlEl.classList.contains('dark') ? '🌙' : '☀️';
      themeBtn.addEventListener('click', function() {
        const isDark = htmlEl.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        themeBtn.innerText = isDark ? '🌙' : '☀️';
      });
    }

    // Search Input
    const searchInput = document.getElementById('searchInput');
    const searchResultCount = document.getElementById('searchResultCount');
    const searchInfo = document.getElementById('searchInfo');
    const searchShowing = document.getElementById('searchShowing');
    const searchTotal = document.getElementById('searchTotal');
    const emptyState = document.getElementById('emptyState');

    // 🔥 SEARCH FUNCTION - Real-time
    searchInput?.addEventListener('input', function(e) {
      const keyword = e.target.value.toLowerCase().trim();
      
      if (keyword === '') {
        // Reset ke semua data
        filteredMembers = [...allMembers];
        searchInfo.classList.add('hidden');
        searchResultCount.classList.add('hidden');
      } else {
        // Filter berdasarkan nama
        filteredMembers = allMembers.filter(member => 
          member.Nama.toLowerCase().includes(keyword) ||
          (member.ID_User && member.ID_User.toLowerCase().includes(keyword))
        );
        
        // Tampilkan info pencarian
        searchShowing.textContent = filteredMembers.length;
        searchTotal.textContent = allMembers.length;
        searchInfo.classList.remove('hidden');
        searchResultCount.textContent = `${filteredMembers.length} hasil`;
        searchResultCount.classList.remove('hidden');
      }
      
      renderTable();
    });

    // Refresh Button
    document.getElementById('btnRefresh')?.addEventListener('click', () => {
      searchInput.value = '';
      loadDashboard();
    });

    async function loadDashboard() {
      const tbody = document.getElementById('tabelAnggota');
      if (tbody) tbody.innerHTML = '<tr><td colspan="7" class="p-8 text-center text-slate-400">Memuat data...</td></tr>';

      try {
        const res = await fetch(API_URL);
        const data = await res.json();
        
        if (!data.users) throw new Error('Data users tidak ditemukan');

        // Filter hanya anggota dari kelompok ketua
        allMembers = data.users.filter(u => {
          const userKelompok = u.Kelompok || u.NamaKelompok || u.Nama_Kelompok || u.kelompok || '';
          return userKelompok.toString().trim().toLowerCase() === KELOMPOK_KETUA.toLowerCase();
        });

        // Reset filtered members
        filteredMembers = [...allMembers];

        // Hitung statistik
        let totalHadir = 0, totalIzin = 0;
        allMembers.forEach(m => {
          const status = (m.Status_Hari_Ini || '').toString().trim();
          if (status === 'Hadir') totalHadir++;
          else if (status === 'Izin') totalIzin++;
        });

        const persentase = allMembers.length > 0 ? ((totalHadir / allMembers.length) * 100).toFixed(1) : 0;

        // Update stats
        document.getElementById('statTotalAnggota').textContent = allMembers.length;
        document.getElementById('statHadir').textContent = totalHadir;
        document.getElementById('statIzin').textContent = totalIzin;
        document.getElementById('statPersen').textContent = persentase + '%';

        // Render tabel
        renderTable();

      } catch (error) {
        console.error('[Ketua Dashboard] Error:', error);
        if (tbody) tbody.innerHTML = '<tr><td colspan="7" class="p-8 text-center text-rose-400 text-xs font-semibold">❌ Gagal memuat data: ' + escapeHtml(error.message) + '</td></tr>';
      }
    }

    // 🔥 RENDER TABLE FUNCTION
    function renderTable() {
      const tbody = document.getElementById('tabelAnggota');
      
      if (filteredMembers.length === 0) {
        tbody.innerHTML = '';
        emptyState.classList.remove('hidden');
        return;
      }
      
      emptyState.classList.add('hidden');
      
      tbody.innerHTML = filteredMembers.map((member, index) => {
        let statusBadge = '';
        let statusClass = '';
        
        if (member.Status_Hari_Ini === 'Hadir') {
          statusBadge = '✓ Hadir';
          statusClass = 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400';
        } else if (member.Status_Hari_Ini === 'Izin') {
          statusBadge = '📝 Izin';
          statusClass = 'bg-amber-500/10 text-amber-600 dark:text-amber-400';
        } else {
          statusBadge = '— Belum';
          statusClass = 'bg-slate-500/10 text-slate-600 dark:text-slate-400';
        }

        const genderBadge = member.Gender === 'Perempuan' 
          ? '<span class="px-2 py-0.5 bg-pink-500/10 text-pink-600 dark:text-pink-400 text-[10px] font-bold rounded-full">♀</span>'
          : '<span class="px-2 py-0.5 bg-blue-500/10 text-blue-600 dark:text-blue-400 text-[10px] font-bold rounded-full">♂</span>';

        const userId = member.ID_User || member.id_user || '';
        const nama = member.Nama || member.nama || '';
        const gender = member.Gender || member.gender || 'Laki-laki';
        const kelompok = member.Kelompok || member.NamaKelompok || member.Nama_Kelompok || member.kelompok || '';

        return '<tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors text-xs">' +
          '<td class="p-3 text-slate-400">' + (index + 1) + '</td>' +
          '<td class="p-3 font-mono text-purple-600 dark:text-purple-400 text-[10px]">' + escapeHtml(userId) + '</td>' +
          '<td class="p-3 font-medium text-slate-900 dark:text-white">' + escapeHtml(nama) + '</td>' +
          '<td class="p-3">' + genderBadge + ' ' + gender + '</td>' +
          '<td class="p-3 text-center"><span class="px-2 py-1 rounded-md text-[10px] font-bold ' + statusClass + '">' + statusBadge + '</span></td>' +
          '<td class="p-3 text-right font-semibold">' + (member.Total_Hadir || 0) + ' hari</td>' +
          '<td class="p-3 text-center">' +
            '<div class="flex gap-1 justify-center">' +
              '<button onclick="openEditUser(\'' + userId + '\',\'' + escapeHtml(nama).replace(/'/g, "\\'") + '\',\'' + gender + '\',\'' + escapeHtml(kelompok).replace(/'/g, "\\'") + '\')" class="px-2 py-1 bg-amber-500/10 text-amber-600 hover:bg-amber-500 hover:text-white text-[10px] font-bold rounded-md transition-all">Edit</button>' +
              '<button onclick="openHapusUser(\'' + userId + '\',\'' + escapeHtml(nama).replace(/'/g, "\\'") + '\')" class="px-2 py-1 bg-rose-500/10 text-rose-600 hover:bg-rose-500 hover:text-white text-[10px] font-bold rounded-md transition-all">Hapus</button>' +
            '</div>' +
          '</td>' +
        '</tr>';
      }).join('');
    }

    function escapeHtml(text) {
      if (!text) return '';
      return String(text)
        .replace(/&/g, '&amp;')
        .replace(/"/g, '&quot;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
    }

    // ==========================================
    // MODAL EDIT USER
    // ==========================================
    const modalEdit = document.getElementById('modalEditUser');
    
    window.openEditUser = function(userId, nama, gender, kelompok) {
      document.getElementById('editUserId').value = userId;
      document.getElementById('editNama').value = nama;
      document.getElementById('editGender').value = gender;
      document.getElementById('editKelompok').value = kelompok;
      modalEdit.classList.remove('hidden');
      modalEdit.classList.add('flex');
    };

    document.getElementById('btnBatalEdit')?.addEventListener('click', () => {
      modalEdit.classList.add('hidden');
      modalEdit.classList.remove('flex');
    });

    document.getElementById('btnSimpanEdit')?.addEventListener('click', async () => {
      const userId = document.getElementById('editUserId').value;
      const nama = document.getElementById('editNama').value;
      const gender = document.getElementById('editGender').value;
      const kelompok = document.getElementById('editKelompok').value;

      if (!nama) return alert('Nama tidak boleh kosong!');

      const payload = new URLSearchParams({
        action: 'update_user_kelompok',
        user_id: userId,
        nama: nama,
        gender: gender,
        kelompok: kelompok,
        ketua_kelompok: KELOMPOK_KETUA
      });

      try {
        const res = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: payload.toString()
        });
        const result = await res.text();

        if (result.includes('KATA_KUNCI_SUKSES')) {
          alert('Data berhasil diupdate!');
          modalEdit.classList.add('hidden');
          modalEdit.classList.remove('flex');
          loadDashboard();
        } else {
          alert('Gagal: ' + result.replace('KATA_KUNCI_GAGAL: ', ''));
        }
      } catch (err) {
        alert('Terjadi kesalahan: ' + err.message);
      }
    });

    // ==========================================
    // MODAL HAPUS USER
    // ==========================================
    const modalHapus = document.getElementById('modalHapus');
    let hapusUserId = '';

    window.openHapusUser = function(userId, nama) {
      hapusUserId = userId;
      document.getElementById('hapusDesc').textContent = 'Hapus "' + nama + '" dari database?';
      modalHapus.classList.remove('hidden');
      modalHapus.classList.add('flex');
    };

    document.getElementById('btnBatalHapus')?.addEventListener('click', () => {
      modalHapus.classList.add('hidden');
      modalHapus.classList.remove('flex');
      hapusUserId = '';
    });

    document.getElementById('btnKonfirmasiHapus')?.addEventListener('click', async () => {
      if (!hapusUserId) return;

      const payload = new URLSearchParams({
        action: 'hapus_user_kelompok',
        user_id: hapusUserId,
        ketua_kelompok: KELOMPOK_KETUA
      });

      try {
        const res = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: payload.toString()
        });
        const result = await res.text();

        if (result.includes('KATA_KUNCI_SUKSES')) {
          alert('User berhasil dihapus!');
          modalHapus.classList.add('hidden');
          modalHapus.classList.remove('flex');
          hapusUserId = '';
          loadDashboard();
        } else {
          alert('Gagal: ' + result.replace('KATA_KUNCI_GAGAL: ', ''));
        }
      } catch (err) {
        alert('Terjadi kesalahan: ' + err.message);
      }
    });

    // Load initial data
    loadDashboard();
  </script>
</body>
</html>