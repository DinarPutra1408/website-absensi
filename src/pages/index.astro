---
let errorMessage = "";
let showCardGenerator = false;
let cardData = { id: "", nama: "", role: "" };

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const usernameInput = formData.get("username")?.toString().trim();
    const passwordInput = formData.get("password")?.toString().trim();

    const GOOGLE_API_URL = import.meta.env.PUBLIC_SECRET_SHEETS_API_URL;

    if (!GOOGLE_API_URL) {
      throw new Error("Variabel PUBLIC_SECRET_SHEETS_API_URL masih bernilai kosong atau salah posisi file!");
    }

    const response = await fetch(GOOGLE_API_URL, {
      method: 'GET',
      redirect: 'follow', 
      headers: {
        'Accept': 'application/json'
      }
    });
    
    const data = await response.json();
    const users = data.users || [];

    const matchedUser = users.find((u: Record<string, string>) => {
      const dbUsername = (u.Username || u.username || u.Username_User || "").toString().trim();
      const dbPassword = (u.Password || u.password || "").toString().trim();
      
      return dbUsername === usernameInput && dbPassword === passwordInput;
    });

    if (matchedUser) {
      const userRole = matchedUser.Role || matchedUser.role || "User";
      const userNama = matchedUser.Nama || matchedUser.nama || "Muda Mudi";
      const userId = matchedUser.ID_User || matchedUser.id_user || "";

      showCardGenerator = true;
      cardData = { id: userId, nama: userNama, role: userRole };
    } else {
      errorMessage = "Username atau password salah!";
    }
  } catch (error) {
    console.error("Detail Error Fetch:", error);
    errorMessage = "Gagal terhubung ke database atau terdapat struktur kolom yang tidak sesuai.";
  }
}
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - Sistem Absensi MM Desa Tandes Barat</title>

  <link rel="manifest" href="/manifest.webmanifest" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="AbsensiMM" />
<link rel="apple-touch-icon" href="/pwa-192x192.png" />
  
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

  <script is:inline>
    // Gunakan class 'dark' sebagai default penamaan standar Tailwind agar sinkron dengan dashboard
    const savedTheme = localStorage.getItem('theme') || 'dark';
    if (savedTheme === 'light') {
      document.documentElement.classList.remove('dark');
    } else {
      document.documentElement.classList.add('dark');
    }
  </script>

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; }
    
    /* TEMA DEFAULT (DARK MODE) */
    :root {
      --bg-gradient: linear-gradient(135deg, #0f172a, #1e1b4b);
      --container-bg: rgba(30, 41, 59, 0.7);
      --container-border: rgba(255, 255, 255, 0.1);
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --input-bg: rgba(15, 23, 42, 0.6);
      --input-border: rgba(255, 255, 255, 0.1);
      --input-text: #ffffff;
      --label-color: #cbd5e1;
      --toggle-bg: rgba(255, 255, 255, 0.08);
      --toggle-text: #ffffff;
      
      /* Variabel khusus Modal & ID Card (Versi Gelap) */
      --modal-bg: #1e293b;
      --modal-text-title: #ffffff;
      --card-bg-gradient: linear-gradient(180deg, #1e1b4b, #090d16);
      --card-text-title: #f1f5f9;
      --card-text-name: #ffffff;
      --card-text-id: #38bdf8;
    }

    /* TEMA LIGHT MODE (Ketika class 'dark' dihapus dari html) */
    html:not(.dark) {
      --bg-gradient: linear-gradient(135deg, #f1f5f9, #e2e8f0);
      --container-bg: rgba(255, 255, 255, 0.85);
      --container-border: rgba(15, 23, 42, 0.1);
      --text-main: #0f172a;
      --text-muted: #64748b;
      --input-bg: #ffffff;
      --input-border: rgba(15, 23, 42, 0.15);
      --input-text: #0f172a;
      --label-color: #475569;
      --toggle-bg: rgba(15, 23, 42, 0.06);
      --toggle-text: #0f172a;
      
      /* Variabel khusus Modal & ID Card (Versi Terang / Pallet Light) */
      --modal-bg: #ffffff;
      --modal-text-title: #0f172a;
      --card-bg-gradient: linear-gradient(180deg, #e2e8f0, #cbd5e1);
      --card-text-title: #1e293b;
      --card-text-name: #0f172a;
      --card-text-id: #2563eb;
    }

    body {
      background: var(--bg-gradient);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 16px;
      transition: background 0.3s ease;
    }

    .login-container {
      background: var(--container-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--container-border);
      padding: 40px 30px;
      border-radius: 24px;
      width: 100%;
      max-width: 420px;
      box-shadow: 0 20px 40px rgba(0,0,0,0.25);
      text-align: center;
      transition: all 0.3s ease;
      position: relative;
    }

    .theme-toggle-container {
      position: absolute;
      top: 18px;
      right: 18px;
      z-index: 50;
    }
    
    .btn-theme-toggle {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background: var(--toggle-bg);
      border: 1px solid var(--container-border);
      color: var(--toggle-text);
      font-size: 1.1rem;
      cursor: pointer;
      display: flex;
      justify-content: center;
      align-items: center;
      transition: all 0.2s ease;
    }
    .btn-theme-toggle:hover {
      transform: scale(1.05);
      background: rgba(99, 102, 241, 0.15);
    }

    .logo-area { font-size: 2.5rem; margin-bottom: 12px; }
    h2 { color: var(--text-main); font-weight: 700; margin-bottom: 8px; letter-spacing: -0.5px; }
    p.subtitle { color: var(--text-muted); font-size: 0.95rem; margin-bottom: 32px; padding: 0 10px; }
    .form-group { text-align: left; margin-bottom: 20px; }
    label { display: block; color: var(--label-color); font-size: 0.85rem; font-weight: 600; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px; }
    
    .password-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }
    
    input {
      width: 100%;
      padding: 14px 16px;
      padding-right: 48px;
      background: var(--input-bg);
      border: 1px solid var(--input-border);
      border-radius: 12px;
      color: var(--input-text);
      font-size: 1rem;
      transition: all 0.3s;
    }
    input:focus { outline: none; border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2); }

    /* FIX BUG MOBILE: Sembunyikan ikon mata hitam bawaan browser Android/Samsung/Edge */
    input::-ms-reveal,
    input::-ms-clear,
    input::-webkit-contacts-auto-fill-button,
    input::-webkit-credentials-auto-fill-button {
      display: none !important;
      width: 0 !important;
      height: 0 !important;
      opacity: 0 !important;
      visibility: hidden !important;
      pointer-events: none !important;
    }
    
    .toggle-password-btn {
      position: absolute;
      right: 14px;
      background: transparent;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      border-radius: 6px;
      transition: all 0.2s ease;
      z-index: 10;
    }
    .toggle-password-btn:hover {
      color: #6366f1;
      background: rgba(99, 102, 241, 0.1);
    }
    .toggle-password-btn svg {
      width: 20px;
      height: 20px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .btn-submit {
      width: 100%;
      padding: 14px;
      background: linear-gradient(90deg, #6366f1, #a855f7);
      border: none;
      border-radius: 12px;
      color: #fff;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: opacity 0.3s, transform 0.2s;
      margin-top: 10px;
    }
    .btn-submit:hover { opacity: 0.9; transform: translateY(-1px); }
    
    .error-box {
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #fca5a5;
      padding: 12px;
      border-radius: 12px;
      font-size: 0.9rem;
      margin-bottom: 20px;
      text-align: left;
    }
    html:not(.dark) .error-box {
      background: #fef2f2;
      border: 1px solid #fca5a5;
      color: #b91c1c;
    }

    /* KARTU MODAL AUTOMATIC THEME */
    .modal-overlay {
      position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(12px);
      display: flex; justify-content: center; align-items: center; z-index: 9999; padding: 16px;
    }
    .modal-content {
      background: var(--modal-bg); 
      border: 1px solid var(--container-border);
      padding: 24px; border-radius: 24px; max-width: 380px; width: 100%; text-align: center;
      box-shadow: 0 20px 50px rgba(0,0,0,0.3);
      transition: background 0.3s ease;
    }
    
    .id-card-wrapper {
      padding: 4px; background: transparent; margin: 15px auto; width: fit-content;
    }
    
    .id-card-print {
      width: 240px; height: 380px; 
      background: var(--card-bg-gradient);
      border-radius: 16px; position: relative; overflow: hidden; padding: 18px 14px; text-align: center; display: flex; flex-direction: column; justify-content: space-between; align-items: center; box-shadow: 0 15px 35px rgba(0,0,0,0.3);
      transition: background 0.3s ease;
    }
    .id-card-print::after {
      content: ''; position: absolute; bottom: -50px; left: -50px; width: 160px; height: 160px;
      background: rgba(99, 102, 241, 0.12); border-radius: 50%; filter: blur(25px);
    }
    
    .card-header-portrait { width: 100%; border-bottom: 2px solid var(--container-border); padding-bottom: 10px; margin-bottom: 2px; }
    .card-logo-portrait { font-size: 1.6rem; margin-bottom: 4px; display: block; }
    
    .card-title-portrait { 
      font-size: 0.82rem; 
      font-weight: 600; 
      letter-spacing: 0.8px; 
      text-transform: uppercase; 
      color: var(--card-text-title); 
      display: block; 
      line-height: 1.3; 
      padding: 0 4px;
    }
    
    .qr-holder-portrait {
      width: 115px; height: 115px; background: white; padding: 6px; border-radius: 10px; display: flex; justify-content: center; align-items: center; margin: 8px 0; box-shadow: 0 8px 20px rgba(0,0,0,0.2); z-index: 10;
    }
    .qr-holder-portrait img { width: 100% !important; height: 100% !important; }
    
    .info-holder-portrait { width: 100%; margin-bottom: 4px; text-align: center; z-index: 10; display: flex; flex-direction: column; justify-content: center; flex-grow: 1; }
    .info-label-portrait { font-size: 0.58rem; color: var(--text-muted); text-transform: uppercase; font-weight: 800; letter-spacing: 0.8px; margin-top: 4px; }
    
    .info-val-nama-portrait { 
      font-size: 0.92rem; 
      font-weight: 700; 
      color: var(--card-text-name); 
      word-break: break-word; 
      overflow-wrap: break-word;
      line-height: 1.25;
      max-height: 2.5em;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin-top: 2px;
      padding: 0 4px;
    }
    .info-val-id-portrait { font-size: 0.9rem; font-weight: 700; color: var(--card-text-id); font-family: 'Courier New', Courier, monospace; letter-spacing: 0.5px; margin-top: 2px; }
    
    /* 🔥 BARU: Badge Role di ID Card */
    .info-val-role-portrait {
      display: inline-block;
      margin-top: 6px;
      padding: 3px 10px;
      font-size: 0.65rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1px;
      border-radius: 20px;
      background: linear-gradient(90deg, #6366f1, #a855f7);
      color: white;
      box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
    }
    .info-val-role-portrait.role-admin {
      background: linear-gradient(90deg, #ef4444, #f97316);
      box-shadow: 0 4px 12px rgba(239, 68, 68, 0.4);
    }
    .info-val-role-portrait.role-bendahara {
      background: linear-gradient(90deg, #10b981, #059669);
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4);
    }
    .info-val-role-portrait.role-user {
      background: linear-gradient(90deg, #6366f1, #a855f7);
      box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
    }
    
    .card-footer-text-portrait { font-size: 0.55rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 1px; border-top: 1px solid var(--container-border); width: 100%; padding-top: 8px; }

    .action-group { display: flex; flex-direction: column; gap: 10px; margin-top: 15px; }
    .btn-download { padding: 12px; background: linear-gradient(90deg, #6366f1, #a855f7); color: white; border: none; border-radius: 12px; font-weight: 600; cursor: pointer; font-size: 0.95rem; transition: opacity 0.2s; }
    .btn-download:hover { opacity: 0.9; }
    .btn-skip { padding: 12px; background: transparent; color: var(--text-muted); border: 1px solid var(--container-border); border-radius: 12px; font-weight: 600; cursor: pointer; font-size: 0.95rem; transition: all 0.2s; }
    .btn-skip:hover { background: var(--toggle-bg); color: var(--text-main); }

    @media (max-width: 400px) {
      .login-container { padding: 35px 20px 25px 20px; }
      p.subtitle { font-size: 0.88rem; margin-bottom: 24px; }
    }
  </style>
</head>
<body>

  <div class="login-container">
    <div class="theme-toggle-container">
      <button type="button" id="globalThemeToggle" class="btn-theme-toggle" title="Ganti Tema">🌙</button>
    </div>

    <div class="logo-area">🕌</div>
    <h2>Selamat Datang</h2>
    <p class="subtitle">Sistem Absensi MM Desa Tandes Barat</p>
    
    {errorMessage && <div class="error-box">⚠️ {errorMessage}</div>}
    
    <form method="POST">
      <div class="form-group">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" placeholder="Masukkan username" required autocomplete="off"/>
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <div class="password-wrapper">
          <input type="password" id="password" name="password" placeholder="••••••••" required/>
          <button type="button" id="togglePasswordBtn" class="toggle-password-btn" title="Lihat Password">
            <svg id="eyeIcon" viewBox="0 0 24 24">
              <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
              <line x1="1" y1="1" x2="23" y2="23"></line>
            </svg>
          </button>
        </div>
      </div>
      <button type="submit" class="btn-submit">Masuk Ke Sistem</button>
    </form>
  </div>

  {showCardGenerator && (
    <div class="modal-overlay" id="cardModal">
      <div class="modal-content">
        <h3 id="modalTitleText" style="color: var(--text-main); font-size: 1.15rem; font-weight: 700; margin-bottom: 2px;">Sukses Terverifikasi!</h3>
        <p style="color: var(--text-muted); font-size: 0.8rem;">Kartu identitas resmi Anda siap didownload.</p>
        
        <div class="id-card-wrapper">
          <div class="id-card-print" id="idCardPayload">
            <div class="card-header-portrait">
              <span class="card-logo-portrait">🕌</span>
              <span class="card-title-portrait">Muda Mudi Tandes Barat</span>
            </div>
            
            <div class="qr-holder-portrait" id="qrcodeTarget" data-id={cardData.id}></div>
            
            <div class="info-holder-portrait">
              <div class="info-label-portrait">Nama Pemilik</div>
              <div class="info-val-nama-portrait">{cardData.nama}</div>
              
              <div class="info-label-portrait">Nomor Registrasi ID</div>
              <div class="info-val-id-portrait">{cardData.id || "TANPA_ID"}</div>
              
              {/* 🔥 BARU: Badge Role */}
              <span class={`info-val-role-portrait ${
                cardData.role === 'Admin' ? 'role-admin' : 
                cardData.role === 'Bendahara' ? 'role-bendahara' : 
                'role-user'
              }`}>
                {cardData.role || 'User'}
              </span>
            </div>
            
            <div class="card-footer-text-portrait">Sistem Absensi</div>
          </div>
        </div>

        <div class="action-group">
          <button type="button" class="btn-download" id="downloadPngBtn">Download Gambar PNG</button>
          <button type="button" class="btn-skip" id="directToDashboardBtn">Masuk ke Dashboard &rarr;</button>
        </div>
      </div>
    </div>
  )}

  <script is:inline define:vars={{ cardData, showCardGenerator }}>
    // 1. LOGIKA SWITCHER DARK / LIGHT MODE SINKRON STANDARD TAILWIND
    const htmlEl = document.documentElement;
    const themeBtn = document.getElementById('globalThemeToggle');
    
    if (themeBtn) {
      themeBtn.innerText = htmlEl.classList.contains('dark') ? '🌙' : '☀️';
      
      themeBtn.addEventListener('click', () => {
        const isDark = htmlEl.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        themeBtn.innerText = isDark ? '🌙' : '☀️';
      });
    }

    // 2. LOGIKA INTIP PASSWORD (FIX MATA NORMAL & DISILANG)
    const passwordInput = document.getElementById('password');
    const togglePasswordBtn = document.getElementById('togglePasswordBtn');
    const eyeIcon = document.getElementById('eyeIcon');

    const openEyePath = `<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>`;
    const closeEyePath = `<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>`;

    togglePasswordBtn?.addEventListener('click', () => {
      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        eyeIcon.innerHTML = openEyePath;  // Kelihatan huruf -> MATA TERBUKA
      } else {
        passwordInput.type = 'password';
        eyeIcon.innerHTML = closeEyePath; // Sembunyi password -> MATA DISILANG
      }
    });

    // 3. LOGIKA REDIRECT & CARD GENERATOR
    // 🔥 DIPERBAIKI: Tambahkan redirect untuk role Bendahara
    function alihkanKeDashboard() {
      const namaEnc = encodeURIComponent(cardData.nama);
      const idEnc = encodeURIComponent(cardData.id);
      const roleEnc = encodeURIComponent(cardData.role);
      
      if (cardData.role === "Admin") {
        window.location.href = `/admin/dashboard?nama=${namaEnc}`;
      } else if (cardData.role === "Bendahara") {
        // 🔥 BARU: Redirect bendahara ke dashboard khusus bendahara
        window.location.href = `/bendahara/dashboard?nama=${namaEnc}`;
      } else {
        window.location.href = `/user/dashboard?id=${idEnc}&nama=${namaEnc}`;
      }
    }

    if (showCardGenerator) {
      const qrTarget = document.getElementById("qrcodeTarget");
      if (qrTarget) {
        const userId = qrTarget.getAttribute("data-id") || "GUEST";
        new QRCode(qrTarget, {
          text: userId,
          width: 103,
          height: 103,
          colorDark: "#000000",
          colorLight: "#ffffff",
          correctLevel: QRCode.CorrectLevel.H
        });
      }

      document.getElementById("downloadPngBtn")?.addEventListener("click", () => {
        const elemenKartu = document.getElementById("idCardPayload");
        const namaFile = `ID_Card_${cardData.nama.replace(/\s+/g, '_')}.png`;

        html2canvas(elemenKartu, {
          scale: 3, 
          useCORS: true,
          backgroundColor: null,
          logging: false
        }).then(canvas => {
          const linkDownload = document.createElement('a');
          linkDownload.download = namaFile;
          linkDownload.href = canvas.toDataURL("image/png");
          linkDownload.click();
          
          setTimeout(alihkanKeDashboard, 1200);
        }).catch(err => {
          console.error("Gagal bikin PNG:", err);
          alihkanKeDashboard();
        });
      });

      document.getElementById("directToDashboardBtn")?.addEventListener("click", () => {
        alihkanKeDashboard();
      });
    }
  </script>
</body>
</html>