    // 🔥 HELPER: Ambil info libur untuk tanggal tertentu
    // Prioritas: Nasional (YYYY-MM-DD) > Internasional (MM-DD)
    function getLiburInfo(dateStr) {
      // Cek dulu apakah ada libur nasional di tanggal spesifik ini
      if (hariLibur[dateStr]) return hariLibur[dateStr];
      // Jika tidak, cek apakah ada hari internasional (format MM-DD)
      const mmdd = dateStr.substring(5); // "MM-DD"
      if (hariLibur[mmdd]) return hariLibur[mmdd];
      return null;
    }

