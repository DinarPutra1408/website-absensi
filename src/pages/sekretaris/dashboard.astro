        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-bold text-purple-600">Agenda #${sesiCounter}</span>
          <button type="button" onclick="this.closest('[data-sesi-id]').remove()" class="w-6 h-6 flex items-center justify-center rounded-full bg-rose-500/10 text-rose-500 hover:bg-rose-500 hover:text-white text-xs font-bold">✕</button>
        </div>
        <div class="grid grid-cols-3 gap-2">
          <div>
            <label class="block text-[10px] font-bold mb-1">Waktu</label>
            <input type="text" class="sesi-waktu w-full p-2 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg text-xs" placeholder="19:30-20:00"/>
          </div>
          <div class="col-span-2">
            <label class="block text-[10px] font-bold mb-1">Nama Agenda</label>
            <input type="text" class="sesi-materi w-full p-2 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg text-xs" placeholder="Tausiyah / Games / Doa / dll"/>
          </div>
          <div class="col-span-3">
            <label class="block text-[10px] font-bold mb-1">PIC / Pengisi (opsional)</label>
            <input type="text" class="sesi-pengajar w-full p-2 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg text-xs" placeholder="Ustadz Ahmad / Panitia / dll"/>
          </div>
        </div>
      `;
      sesiContainer.appendChild(div);
    });

    btnBatal?.addEventListener('click', resetForm);

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const isEdit = editRow.value !== '';
      
      const sesiList = [];
      document.querySelectorAll('[data-sesi-id]').forEach(div => {
        sesiList.push({
          waktu: div.querySelector('.sesi-waktu')?.value || '',
          materi: div.querySelector('.sesi-materi')?.value || '',
          pengajar: div.querySelector('.sesi-pengajar')?.value || ''
        });
      });
      const sesiJSON = JSON.stringify(sesiList);

      let pengajar = '';
      if (sesiList.length > 0) {
        pengajar = sesiList.map(s => s.pengajar).filter(p => p).join(', ');
      }

      const payload = new URLSearchParams({
        action: isEdit ? 'update_jadwal_kegiatan' : 'tambah_jadwal_kegiatan',
        tanggal: document.getElementById('inpTanggal').value,
        tanggal_selesai: document.getElementById('inpTanggalSelesai').value,
        jam_mulai: document.getElementById('inpJamMulai').value,
        jam_selesai: document.getElementById('inpJamSelesai').value,
        judul_besar: document.getElementById('inpJudulBesar').value,
        sub_judul: '',
        pengajar: pengajar,
        mc: document.getElementById('inpMC').value,
        tempat: document.getElementById('inpTempat').value,
        peserta: document.getElementById('inpPeserta').value,
        deskripsi: document.getElementById('inpDeskripsi').value,
        status: 'Dijadwalkan',
        dibuat_oleh: SEKRETARIS_NAMA,
        sesi_json: sesiJSON
      });

      if (isEdit) payload.append('row_number', editRow.value);

      try {
        const res = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: payload.toString()
        });
        const result = await res.text();
        
        if (result.includes('KATA_KUNCI_SUKSES')) {
          alert(isEdit ? '✅ Kegiatan diperbarui!' : '✅ Kegiatan ditambahkan!');
          resetForm();
          document.getElementById('formModal').classList.add('hidden');
          document.getElementById('formModal').classList.remove('flex');
          loadKegiatan();
        } else {
          alert('❌ Gagal: ' + result);
        }
      } catch (err) {
        alert('❌ Error: ' + err.message);
      }
    });

    window.editKegiatan = function(row) {
      const k = allKegiatan.find(x => x.Row === row);
      if (!k) return;
      
      editRow.value = row;
      document.getElementById('inpTanggal').value = k.Tanggal ? new Date(k.Tanggal).toISOString().slice(0,10) : '';
      document.getElementById('inpTanggalSelesai').value = k.Tanggal_Selesai ? new Date(k.Tanggal_Selesai).toISOString().slice(0,10) : '';
      
      document.getElementById('inpJamMulai').value = k.Jam_Mulai ? formatTime(k.Jam_Mulai) : '';
      document.getElementById('inpJamSelesai').value = k.Jam_Selesai ? formatTime(k.Jam_Selesai) : '';
      
      document.getElementById('inpJudulBesar').value = k.Judul_Besar || '';
      document.getElementById('inpMC').value = k.MC || '';
      document.getElementById('inpTempat').value = k.Tempat || '';
      document.getElementById('inpPeserta').value = k.Peserta || '';
      document.getElementById('inpDeskripsi').value = k.Deskripsi || '';
      
      sesiContainer.innerHTML = '';
      sesiCounter = 0;
      try {
        const sesiList = JSON.parse(k.Sesi_JSON || '[]');
        sesiList.forEach(s => {
          sesiCounter++;
          const div = document.createElement('div');
          div.className = 'p-3 bg-purple-50 dark:bg-purple-900/20 rounded-xl border border-purple-200 dark:border-purple-800 relative';
          div.dataset.sesiId = sesiCounter;
          div.innerHTML = `
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-purple-600">Agenda #${sesiCounter}</span>
              <button type="button" onclick="this.closest('[data-sesi-id]').remove()" class="w-6 h-6 flex items-center justify-center rounded-full bg-rose-500/10 text-rose-500 hover:bg-rose-500 hover:text-white text-xs font-bold">✕</button>
            </div>
            <div class="grid grid-cols-3 gap-2">
              <div>
                <label class="block text-[10px] font-bold mb-1">Waktu</label>
                <input type="text" class="sesi-waktu w-full p-2 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg text-xs" value="${s.waktu || ''}" placeholder="19:30-20:00"/>
              </div>
              <div class="col-span-2">
                <label class="block text-[10px] font-bold mb-1">Nama Agenda</label>
                <input type="text" class="sesi-materi w-full p-2 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg text-xs" value="${s.materi || ''}" placeholder="Tausiyah / Games / Doa / dll"/>
              </div>
              <div class="col-span-3">
                <label class="block text-[10px] font-bold mb-1">PIC / Pengisi</label>
                <input type="text" class="sesi-pengajar w-full p-2 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg text-xs" value="${s.pengajar || ''}" placeholder="Ustadz Ahmad / Panitia / dll"/>
              </div>
            </div>
          `;
          sesiContainer.appendChild(div);
        });
      } catch(e) {}
      
      formTitle.textContent = 'Edit Kegiatan';
      btnBatal.classList.remove('hidden');
      document.getElementById('btnSubmit').textContent = '✏️ Update Kegiatan';
      document.getElementById('formModal').classList.remove('hidden');
      document.getElementById('formModal').classList.add('flex');
    };

    window.hapusKegiatan = async function(row, judul) {
      if (!confirm(`Hapus kegiatan "${judul}"?`)) return;
      try {
        const payload = new URLSearchParams({ action: 'hapus_jadwal_kegiatan', row_number: String(row) });
        await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: payload.toString()
        });
        loadKegiatan();
      } catch (err) {
        alert('Gagal hapus: ' + err.message);
      }
    };

    // ==========================================
    // 🔥 FITUR LAPORAN KEGIATAN
    // ==========================================
    window.openLaporanModal = function(row, judul) {
      const k = allKegiatan.find(x => x.Row === row);
      if (!k) return;
      
      document.getElementById('laporanRowNumber').value = row;
      document.getElementById('laporanJudul').textContent = judul;
      document.getElementById('inpLaporan').value = k.Laporan || '';
      
      document.getElementById('laporanModal').classList.remove('hidden');
      document.getElementById('laporanModal').classList.add('flex');
    };

    document.getElementById('btnSimpanLaporan')?.addEventListener('click', async () => {
      const row = document.getElementById('laporanRowNumber').value;
      const laporan = document.getElementById('inpLaporan').value;
      
      if (!laporan.trim()) {
        alert('Laporan tidak boleh kosong!');
        return;
      }
      
      try {
        const payload = new URLSearchParams({
          action: 'update_laporan_kegiatan',
          row_number: row,
          laporan: laporan
        });
        
        const res = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: payload.toString()
        });
        const result = await res.text();
        
        if (result.includes('KATA_KUNCI_SUKSES')) {
          alert('✅ Laporan berhasil disimpan!');
          document.getElementById('laporanModal').classList.add('hidden');
          document.getElementById('laporanModal').classList.remove('flex');
          loadKegiatan(); 
        } else {
          alert('❌ Gagal: ' + result);
        }
      } catch (err) {
        alert('❌ Error: ' + err.message);
      }
    });

    async function loadKegiatan() {
      try {
        const res = await fetch(API_URL);
        const data = await res.json();
        allKegiatan = data.jadwalKegiatan?.data || [];
        renderCalendar();
        renderListView();
      } catch (err) {
        console.error('Error:', err);
      }
    }

    loadKegiatan();
  </script>
</body>
</html>