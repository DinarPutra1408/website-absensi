    function generateTextWA(k) {
      const tgl = new Date(k.Tanggal);
      const hariList = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
      const bulanList = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
      
      const hari = hariList[tgl.getDay()];
      const tanggalNum = tgl.getDate();
      const bulan = bulanList[tgl.getMonth()];
      const tahun = tgl.getFullYear();
      
      let tanggalText = `Hari ${hari}, ${tanggalNum} ${bulan} ${tahun}`;
      if (k.Tanggal_Selesai) {
        const tgl2 = new Date(k.Tanggal_Selesai);
        const hari2 = hariList[tgl2.getDay()];
        const tanggalNum2 = tgl2.getDate();
        const bulan2 = bulanList[tgl2.getMonth()];
        const tahun2 = tgl2.getFullYear();
        tanggalText += ` s/d Hari ${hari2}, ${tanggalNum2} ${bulan2} ${tahun2}`;
      }
      
      const jamMulai = formatTime(k.Jam_Mulai);
      const jamSelesai = formatTime(k.Jam_Selesai);
      const jamStr = jamSelesai ? `${jamMulai} - ${jamSelesai} WIB` : `${jamMulai} WIB`;

      let text = `*${k.Judul_Besar}*\n\n`;
      text += `Mengundang Pemuda Pemudi Sak Desa Tandes Barat pada :\n\n`;
      text += `📆 _${tanggalText}_\n`;
      text += `🕣 Pukul ${jamStr}\n`;
      
      let sesiList = [];
      try { sesiList = JSON.parse(k.Sesi_JSON || '[]'); } catch(e) {}
      
      if (sesiList.length > 0) {
        text += `\n📋 *AGENDA:*\n`;
        sesiList.forEach((s, i) => {
          text += `\n  *${i+1}. ${s.materi || '-'}* (${s.waktu || '-'})\n`;
          if (s.pengajar) text += `      👤 PIC: ${s.pengajar}\n`;
        });
      }
      
      if (k.MC) text += `\n🎤 MC : ${k.MC}\n`;
      if (k.Peserta) text += `👥 Peserta : ${k.Peserta}\n`;
      if (k.Tempat) text += `📍 Tempat : ${k.Tempat}\n`;
      if (k.Deskripsi) text += `\n📝 ${k.Deskripsi}\n`;
      text += `\nKerjakan karena Allah semoga Allah paring aman selamat lancar dan barokah.\n\n`;
      text += `ALHAMDULILLAH JAZA KUMULLOHU KHOIRO\n🙏🙏🙏`;

      return text;
    }

    function generateWAUrlKetua(k) {
      const text = generateTextWA(k);
      return `https://wa.me/${NOMOR_KETUA}?text=${encodeURIComponent(text)}`;
    }

    function generateWAUrlGrup(k) {
      const text = generateTextWA(k);
      return `https://wa.me/?text=${encodeURIComponent(text)}`;
    }

    function renderCalendar() {
      const grid = document.getElementById('calendarGrid');
      const title = document.getElementById('calendarTitle');
      const bulanList = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
      
      title.textContent = `${bulanList[currentMonth]} ${currentYear}`;
      grid.innerHTML = '';

      const firstDay = new Date(currentYear, currentMonth, 1);
      const lastDay = new Date(currentYear, currentMonth + 1, 0);
      const daysInMonth = lastDay.getDate();
      
      let startDay = firstDay.getDay() - 1;
      if (startDay < 0) startDay = 6;

      const today = new Date();
      today.setHours(0,0,0,0);

      for (let i = 0; i < startDay; i++) {
        grid.innerHTML += '<div class="aspect-square"></div>';
      }

      for (let d = 1; d <= daysInMonth; d++) {
        const date = new Date(currentYear, currentMonth, d);
        const dateStr = `${currentYear}-${String(currentMonth+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
        const dayOfWeek = date.getDay();
        const isWeekend = dayOfWeek === 0 || dayOfWeek === 6;
        
        // 🔥 PAKAI HELPER BARU (prioritas: nasional > internasional)
        const liburInfo = getLiburInfo(dateStr);
        const isLiburNasional = liburInfo && liburInfo.tipe === 'nasional';
        const isLiburInternasional = liburInfo && liburInfo.tipe === 'internasional';
        const isToday = date.getTime() === today.getTime();
        
        const kegiatanHariIni = allKegiatan.filter(k => {
          const tglMulai = new Date(k.Tanggal);
          const tglSelesai = k.Tanggal_Selesai ? new Date(k.Tanggal_Selesai) : tglMulai;
          tglMulai.setHours(0,0,0,0);
          tglSelesai.setHours(23,59,59,999);
          return date >= tglMulai && date <= tglSelesai;
        });

        let cellClass = 'aspect-square p-1 rounded-lg border text-xs flex flex-col items-start justify-start cursor-pointer transition-all hover:scale-105 ';
        
        if (isToday) cellClass += 'bg-emerald-500/20 border-emerald-500 ';
        else if (isLiburNasional) cellClass += 'bg-rose-500/20 border-rose-400 ';
        else if (isLiburInternasional) cellClass += 'bg-blue-500/20 border-blue-400 ';
        else if (isWeekend) cellClass += 'bg-slate-200 dark:bg-slate-700 border-slate-300 dark:border-slate-600 ';
        else if (kegiatanHariIni.length > 0) cellClass += 'bg-purple-500/20 border-purple-500 ';
        else cellClass += 'bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-700 ';

        let cellContent = `<div class="font-bold ${isToday ? 'text-emerald-600' : isLiburNasional ? 'text-rose-600' : isLiburInternasional ? 'text-blue-600' : 'text-slate-700 dark:text-slate-300'}">${d}</div>`;
        
        if (liburInfo) {
          const shortName = liburInfo.nama.length > 15 ? liburInfo.nama.substring(0, 15) + '...' : liburInfo.nama;
          cellContent += `<div class="text-[8px] ${isLiburNasional ? 'text-rose-600' : 'text-blue-600'} font-bold mt-0.5 leading-tight">${shortName}</div>`;
        }
        
        kegiatanHariIni.slice(0, 2).forEach(k => {
          const shortTitle = (k.Judul_Besar || '').substring(0, 15);
          cellContent += `<div class="text-[8px] bg-purple-500 text-white px-1 rounded mt-0.5 truncate w-full leading-tight">${shortTitle}</div>`;
        });
        
        if (kegiatanHariIni.length > 2) {
          cellContent += `<div class="text-[8px] text-purple-600 font-bold">+${kegiatanHariIni.length - 2}</div>`;
        }

        grid.innerHTML += `<div class="${cellClass}" onclick="showDateDetail('${dateStr}')">${cellContent}</div>`;
      }
    }

    window.showDateDetail = function(dateStr) {
      const kegiatan = allKegiatan.filter(k => {
        const tglMulai = new Date(k.Tanggal);
        const tglSelesai = k.Tanggal_Selesai ? new Date(k.Tanggal_Selesai) : tglMulai;
        tglMulai.setHours(0,0,0,0);
        tglSelesai.setHours(23,59,59,999);
        const target = new Date(dateStr);
        return target >= tglMulai && target <= tglSelesai;
      });

      const dateObj = new Date(dateStr);
      const hariList = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
      const bulanList = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
      const dateDisplay = `${hariList[dateObj.getDay()]}, ${dateObj.getDate()} ${bulanList[dateObj.getMonth()]} ${dateObj.getFullYear()}`;
      
      // 🔥 PAKAI HELPER BARU
      const liburInfo = getLiburInfo(dateStr);
      const isWeekend = dateObj.getDay() === 0 || dateObj.getDay() === 6;

      let html = `<div class="p-4">
        <h3 class="font-bold text-base mb-1">${dateDisplay}</h3>`;
      
      if (liburInfo) {
        const badgeColor = liburInfo.tipe === 'nasional' ? 'bg-rose-500/20 text-rose-600 border-rose-500/30' : 'bg-blue-500/20 text-blue-600 border-blue-500/30';
        const tipeLabel = liburInfo.tipe === 'nasional' ? '🇮🇩 Libur Nasional' : '🌍 Hari Internasional';
        html += `<div class="mb-2 p-2 ${badgeColor} border rounded-lg">
          <div class="text-[10px] font-bold uppercase">${tipeLabel}</div>
          <div class="text-sm font-bold">${liburInfo.nama}</div>
        </div>`;
      } else if (isWeekend) {
        html += '<div class="text-xs text-slate-500 font-bold mb-2">📅 Weekend</div>';
      }

      if (kegiatan.length === 0) {
        html += '<div class="text-sm text-slate-400 text-center py-4">Tidak ada kegiatan</div>';
      } else {
        kegiatan.forEach(k => {
          let sesiHTML = '';
          try {
            const sesiList = JSON.parse(k.Sesi_JSON || '[]');
            if (sesiList.length > 0) {
              sesiHTML = '<div class="mt-2 space-y-1">' + sesiList.map((s, i) => 
                `<div class="text-[11px] bg-purple-50 dark:bg-purple-900/20 p-2 rounded border-l-2 border-purple-500">
                  <div class="font-bold text-purple-600">Agenda ${i+1}: ${s.waktu || '-'}</div>
                  <div class="text-slate-700 dark:text-slate-300">📋 ${s.materi || '-'}</div>
                  ${s.pengajar ? `<div class="text-slate-500 text-[10px]">👤 PIC: ${s.pengajar}</div>` : ''}
                </div>`
              ).join('') + '</div>';
            }
          } catch(e) {}

          const urlKetua = generateWAUrlKetua(k);
          const urlGrup = generateWAUrlGrup(k);

          html += `<div class="mt-3 p-3 bg-purple-50 dark:bg-purple-900/20 rounded-xl border border-purple-200 dark:border-purple-800">
            <div class="font-bold text-sm text-slate-900 dark:text-white">${k.Judul_Besar}</div>
            <div class="text-[11px] text-slate-500 mt-1">🕐 ${formatTime(k.Jam_Mulai) || '-'}${k.Jam_Selesai ? ' - ' + formatTime(k.Jam_Selesai) : ''}</div>
            ${k.MC ? `<div class="text-[11px] text-slate-500">🎤 MC: ${k.MC}</div>` : ''}
            ${k.Tempat ? `<div class="text-[11px] text-slate-500">📍 ${k.Tempat}</div>` : ''}
            ${sesiHTML}
            <div class="grid grid-cols-2 gap-2 mt-2">
              <a href="${urlKetua}" target="_blank" rel="noopener noreferrer"
                class="py-1.5 bg-green-500/10 text-green-600 hover:bg-green-500 hover:text-white text-[10px] font-bold rounded-md text-center transition-all">
                📱 Kirim ke Ketua
              </a>
              <a href="${urlGrup}" target="_blank" rel="noopener noreferrer"
                class="py-1.5 bg-blue-500/10 text-blue-600 hover:bg-blue-500 hover:text-white text-[10px] font-bold rounded-md text-center transition-all">
                📢 Kirim ke Grup
              </a>
            </div>
            <button onclick="openLaporanModal(${k.Row}, '${(k.Judul_Besar||'').replace(/'/g,"\\'")}')" 
              class="w-full py-1.5 mt-2 bg-amber-500/10 text-amber-600 hover:bg-amber-500 hover:text-white text-[10px] font-bold rounded-md text-center transition-all">
              📝 Lihat / Input Laporan
            </button>
          </div>`;
        });
      }

      html += '</div>';
      
      const modal = document.createElement('div');
      modal.className = 'fixed inset-0 bg-black/60 backdrop-blur-sm z-[60] flex items-center justify-center p-4';
      modal.innerHTML = `<div class="bg-white dark:bg-slate-900 rounded-2xl w-full max-w-md shadow-2xl border border-slate-200 dark:border-slate-700 max-h-[80vh] overflow-y-auto">${html}
        <div class="p-3 border-t border-slate-200 dark:border-slate-700">
          <button onclick="this.closest('.fixed').remove()" class="w-full py-2 bg-slate-200 dark:bg-slate-700 font-bold rounded-xl text-sm">Tutup</button>
        </div>
      </div>`;
      document.body.appendChild(modal);
    };

    function renderListView() {
      const container = document.getElementById('listView');
      const today = new Date();
      today.setHours(0,0,0,0);

      if (allKegiatan.length === 0) {
        container.innerHTML = '<div class="bg-white dark:bg-slate-800 rounded-2xl p-8 text-center text-slate-400">Belum ada kegiatan</div>';
        return;
      }

      container.innerHTML = allKegiatan.map(k => {
        const tglObj = new Date(k.Tanggal);
        const isPast = tglObj < today;
        const diffDays = Math.ceil((tglObj - today) / (1000*60*60*24));
        
        let badge = '';
        if (isPast) badge = '<span class="px-2 py-0.5 bg-slate-500/10 text-slate-500 text-[10px] font-bold rounded-full">Lampau</span>';
        else if (diffDays === 0) badge = '<span class="px-2 py-0.5 bg-rose-500/20 text-rose-500 text-[10px] font-bold rounded-full animate-pulse">Hari Ini!</span>';
        else if (diffDays <= 7) badge = `<span class="px-2 py-0.5 bg-amber-500/20 text-amber-600 text-[10px] font-bold rounded-full">H-${diffDays}</span>`;
        else badge = `<span class="px-2 py-0.5 bg-emerald-500/20 text-emerald-600 text-[10px] font-bold rounded-full">H-${diffDays}</span>`;

        const tglStr = tglObj.toLocaleDateString('id-ID', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
        const tglSelesaiStr = k.Tanggal_Selesai ? new Date(k.Tanggal_Selesai).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '';
        const dateRange = tglSelesaiStr ? `${tglStr} - ${tglSelesaiStr}` : tglStr;

        let sesiHTML = '';
        try {
          const sesiList = JSON.parse(k.Sesi_JSON || '[]');
          if (sesiList.length > 0) {
            sesiHTML = '<div class="mt-2 space-y-1">' + sesiList.map((s, i) => 
              `<div class="text-[11px] bg-purple-50 dark:bg-purple-900/20 p-2 rounded border-l-2 border-purple-500">
                <div class="font-bold text-purple-600">Agenda ${i+1}: ${s.waktu || '-'}</div>
                <div class="text-slate-700 dark:text-slate-300">📋 ${s.materi || '-'}</div>
                ${s.pengajar ? `<div class="text-slate-500 text-[10px]">👤 PIC: ${s.pengajar}</div>` : ''}
              </div>`
            ).join('') + '</div>';
          }
        } catch(e) {}

        const urlKetua = generateWAUrlKetua(k);
        const urlGrup = generateWAUrlGrup(k);

        return `<div class="bg-white dark:bg-slate-800 rounded-2xl p-4 shadow-sm border border-slate-200 dark:border-slate-700 ${isPast ? 'opacity-60' : ''}">
          <div class="flex justify-between items-start gap-3">
            <div class="flex-1">
              <div class="flex items-center gap-2 flex-wrap mb-1">
                <h3 class="font-bold text-sm text-slate-900 dark:text-white">${k.Judul_Besar || '-'}</h3>
                ${badge}
              </div>
              <div class="text-xs text-slate-500 space-y-0.5">
                <div>🗓️ ${dateRange} • 🕐 ${formatTime(k.Jam_Mulai) || '-'}${k.Jam_Selesai ? ' - ' + formatTime(k.Jam_Selesai) : ''}</div>
                ${k.MC ? `<div>🎤 MC: ${k.MC}</div>` : ''}
                ${k.Tempat ? `<div>📍 ${k.Tempat}</div>` : ''}
                ${k.Peserta ? `<div>👥 ${k.Peserta}</div>` : ''}
              </div>
              ${sesiHTML}
              ${k.Deskripsi ? `<div class="mt-2 text-xs text-slate-400 italic">${k.Deskripsi}</div>` : ''}
            </div>
            <div class="flex flex-col gap-1 shrink-0">
              <a href="${urlKetua}" target="_blank" rel="noopener noreferrer"
                class="px-3 py-1.5 bg-green-500/10 text-green-600 hover:bg-green-500 hover:text-white text-[10px] font-bold rounded-md text-center transition-all">📱 Ketua</a>
              <a href="${urlGrup}" target="_blank" rel="noopener noreferrer"
                class="px-3 py-1.5 bg-blue-500/10 text-blue-600 hover:bg-blue-500 hover:text-white text-[10px] font-bold rounded-md text-center transition-all">📢 Grup</a>
              <button onclick="editKegiatan(${k.Row})" 
                class="px-3 py-1.5 bg-amber-500/10 text-amber-600 hover:bg-amber-500 hover:text-white text-[10px] font-bold rounded-md">✏️</button>
              <button onclick="openLaporanModal(${k.Row}, '${(k.Judul_Besar||'').replace(/'/g,"\\'")}')" 
                class="px-3 py-1.5 bg-indigo-500/10 text-indigo-600 hover:bg-indigo-500 hover:text-white text-[10px] font-bold rounded-md">📝</button>
              <button onclick="hapusKegiatan(${k.Row},'${(k.Judul_Besar||'').replace(/'/g,"\\'")}')" 
                class="px-3 py-1.5 bg-rose-500/10 text-rose-600 hover:bg-rose-500 hover:text-white text-[10px] font-bold rounded-md">🗑️</button>
            </div>
          </div>
        </div>`;
      }).join('');
    }

