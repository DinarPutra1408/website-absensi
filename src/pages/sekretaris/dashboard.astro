    // 🔥 FIX BUG WAKTU (1899-12-30...)
    function formatTime(timeVal) {
      if (!timeVal && timeVal !== 0) return '';
      if (typeof timeVal === 'number') {
        const totalMinutes = Math.round(timeVal * 24 * 60);
        const hours = Math.floor(totalMinutes / 60) % 24;
        const minutes = totalMinutes % 60;
        return `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}`;
      }
      if (typeof timeVal === 'string') {
        if (timeVal.includes('1899') || timeVal.includes('1900')) {
          const d = new Date(timeVal);
          if (!isNaN(d.getTime())) return d.toTimeString().substring(0, 5);
        }
        if (timeVal.length === 5 && timeVal.includes(':')) return timeVal;
        if (timeVal.length === 8 && timeVal.includes(':')) return timeVal.substring(0, 5);
      }
      return timeVal;
