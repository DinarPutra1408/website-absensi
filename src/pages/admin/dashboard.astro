---
// PENTING: Semua import WAJIB berada di paling atas agar tidak error esbuild
import '../../global.css';

// Menggunakan standar bawaan Astro untuk membaca Env dari Vercel
const DIRECT_API_URL = import.meta.env.PUBLIC_SECRET_SHEETS_API_URL;
const adminNama = Astro.url.searchParams.get('nama') || 'Admin';

let databaseSemuaUser = []; 
let totalMudaMudiAktif = 0; 
let targetNgajiPusat = 2;
let globalHadirPct = 0;
let totalHadirHariIni = 0;
let totalIzinHariIni = 0;
let awalHadirHariIni = []; 

try {
  if (!DIRECT_API_URL) {
    console.error("LOG - URL API Kosong! Pastikan env di Vercel sudah benar.");
  }

  const response = await fetch(DIRECT_API_URL);
  const data = await response.json();
  
  if (data.users) {
    const allUsers = data.users.filter((u: Record<string, any>) => u.Role === 'User');
    totalMudaMudiAktif = allUsers.length;
    
    // Hitung total hadir dan izin
    totalHadirHariIni = allUsers.filter((u: Record<string, any>) => u.Status_Hari_Ini === 'Hadir').length;
    totalIzinHariIni = allUsers.filter((u: Record<string, any>) => u.Status_Hari_Ini === 'Izin').length;

    databaseSemuaUser = allUsers.map((u: Record<string, any>) => ({
      id: u.ID_User,
      nama: u.Nama,
      status: u.Status_Hari_Ini,
      kelompok: u.Kelompok || u.NamaKelompok || u.Nama_Kelompok || u.kelompok || '-',
      gender: u.Gender || u.gender || 'Laki-laki'
    }));

    // Ambil data yang Hadir ATAU Izin untuk ditampilkan di tabel
    awalHadirHariIni = allUsers.filter((u: Record<string, any>) => u.Status_Hari_Ini === 'Hadir' || u.Status_Hari_Ini === 'Izin').map((u: Record<string, any>) => ({
      ID_User: u.ID_User,
      Nama: u.Nama,
      Gender: u.Gender || u.gender || 'Laki-laki',
      Kelompok: u.Kelompok || u.NamaKelompok || u.Nama_Kelompok || u.kelompok || '-',
      Total_Hadir: u.Total_Hadir || 0,
      Status: u.Status_Hari_Ini // Simpan status untuk UI
    }));
  }
  
  if (data.settings) {
    if (data.settings["Target_Ngaji_1_Bulan"] !== undefined) {
      targetNgajiPusat = parseInt(data.settings["Target_Ngaji_1_Bulan"]);
    } else if (data.settings["Target_Hadir_1_Bulan"] !== undefined) {
      targetNgajiPusat = parseInt(data.settings["Target_Hadir_1_Bulan"]);
    }
  }

  if (totalMudaMudiAktif > 0) {
    globalHadirPct = Math.round((totalHadirHariIni / totalMudaMudiAktif) * 100);
  }
} catch (error) {
  console.error("LOG - Gagal memuat data awal:", error);
}
---

<!DOCTYPE html>
<html lang="id" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Panel Utama Kontrol - Absensi Muda Mudi Tandes Barat</title>

  <link rel="manifest" href="/manifest.webmanifest" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="MM Tandes" />
<link rel="apple-touch-icon" href="/pwa-192x192.png" />
  
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline>
    tailwind.config = { darkMode: 'class' }
    const savedTheme = localStorage.getItem('theme') || 'dark';
    if (savedTheme === 'light') document.documentElement.classList.remove('dark');
    else document.documentElement.classList.add('dark');
  </script>
  <script is:inline src="https://unpkg.com/html5-qrcode"></script>
  
  <style is:global>
    #reader { border: none !important; width: 100% !important; }
    #reader video { border-radius: 12px !important; object-fit: cover !important; width: 100% !important; max-height: 320px !important; background: #000; }
    #reader__dashboard_section_csr button, #reader__dashboard_section_swaplink, button img {
      background-color: #4f46e5 !important; color: white !important; border-radius: 10px !important; padding: 10px 20px !important; font-weight: 600 !important; border: none !important; cursor: pointer !important; margin: 8px auto !important; transition: all 0.2s;
    }
    /* Highlight text yang di-search */
    .highlight-match {
      background-color: rgba(99, 102, 241, 0.25);
      color: inherit;
      padding: 0 2px;
      border-radius: 3px;
      font-weight: 700;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-950 dark:bg-[#090d16] dark:text-slate-100 min-h-screen p-3 md:p-8 font-sans transition-colors duration-300">
  
  <div class="max-w-6xl mx-auto" id="adminDashboard" data-api={DIRECT_API_URL}>
    
    <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 pb-5 mb-6 border-b border-slate-200 dark:border-slate-800">
      <div>
        <h1 class="text-xl md:text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Panel Utama <span class="text-indigo-600 dark:text-indigo-400">Absensi</span></h1>
        <p class="text-xs text-slate-500 dark:text-slate-400">Absensi MM Desa Tandes Barat.</p>
      </div>
      <div class="flex items-center gap-3 w-full sm:w-auto justify-between sm:justify-end">
        <button id="themeToggleBtn" class="w-10 h-10 flex items-center justify-center rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-lg hover:bg-slate-100 dark:hover:bg-slate-800 shadow-sm transition-all">🌙</button>
        <div class="flex items-center gap-2">
          <span class="text-xs text-slate-600 dark:text-slate-400">Admin: <b class="text-slate-900 dark:text-slate-200">{adminNama}</b></span>
          <a href="/" class="px-3 py-1.5 bg-rose-500 hover:bg-rose-600 text-white text-xs font-semibold rounded-xl shadow-md transition-all">Keluar</a>
        </div>
      </div>
    </header>

    <div class="flex flex-col gap-3 mb-6">
      <div class="grid grid-cols-3 gap-3">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-4 rounded-2xl shadow-sm relative overflow-hidden before:content-[''] before:absolute before:left-0 before:top-0 before:h-full before:w-1 before:bg-blue-500">
          <h3 class="text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1">Rerata Hadir</h3>
          <div class="text-xl md:text-3xl font-extrabold text-slate-900 dark:text-white">{globalHadirPct}%</div>
        </div>
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-4 rounded-2xl shadow-sm relative overflow-hidden before:content-[''] before:absolute before:left-0 before:top-0 before:h-full before:w-1 before:bg-emerald-500">
          <h3 class="text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1">Hadir Hari Ini</h3>
          <div class="text-xl md:text-3xl font-extrabold text-slate-900 dark:text-white">{totalHadirHariIni} <span class="text-xs font-medium text-slate-400">Jiwa</span></div>
        </div>
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-4 rounded-2xl shadow-sm relative overflow-hidden before:content-[''] before:absolute before:left-0 before:top-0 before:h-full before:w-1 before:bg-amber-500">
          <h3 class="text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1">Izin Hari Ini</h3>
          <div class="text-xl md:text-3xl font-extrabold text-slate-900 dark:text-white">{totalIzinHariIni} <span class="text-xs font-medium text-slate-400">Jiwa</span></div>
        </div>
      </div>

      <div class="grid grid-cols-3 gap-2">
        <button id="btnRefreshHalaman" class="py-2.5 bg-slate-200 dark:bg-slate-800 hover:bg-slate-300 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 text-xs font-bold rounded-xl transition-all shadow-sm flex items-center justify-center gap-1.5">
          🔄 Refresh Data
        </button>
        <button id="btnKirimWA" class="py-2.5 bg-green-500 hover:bg-green-600 text-white text-xs font-bold rounded-xl transition-all shadow-sm flex items-center justify-center gap-1.5">
          📲 Kirim Rekap WA
        </button>
        <button id="btnResetMassalHariIni" class="py-2.5 bg-rose-500/10 hover:bg-rose-600 text-rose-500 hover:text-white text-xs font-bold rounded-xl transition-all shadow-sm flex items-center justify-center gap-1.5 border border-rose-500/20">
          ⚠️ Reset Massal
        </button>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-6">
      <div class="lg:col-span-7 lg:order-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-4 md:p-6 rounded-2xl shadow-sm flex flex-col justify-between">
        <div>
          <h2 class="text-sm md:text-base font-bold border-l-4 border-emerald-500 pl-2.5 text-slate-900 dark:text-white">Scan Kartu QR Muda Mudi</h2>
          <p class="text-[11px] text-slate-400 dark:text-slate-500 mb-4">Arahkan barcode kartu ke kamera untuk absensi otomatis.</p>
        </div>
        <div class="w-full bg-slate-100 dark:bg-slate-950 rounded-xl p-2 md:p-4 border border-slate-200 dark:border-slate-800 flex items-center justify-center min-h-[220px]">
          <div id="reader"></div>
        </div>
      </div>

      <div class="lg:col-span-5 lg:order-1 flex flex-col gap-6">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-4 md:p-6 rounded-2xl shadow-sm">
          <h2 class="text-sm md:text-base font-bold mb-1 border-l-4 border-indigo-500 pl-2.5 text-slate-900 dark:text-white">Ketik Nama / Absen Cepat</h2>
          <p class="text-[11px] text-slate-400 dark:text-slate-500 mb-3">Klik nama untuk langsung absen (Hadir/Izin).</p>
          
          <div class="relative mb-4">
            <input type="text" id="search_nama" placeholder="Cari nama muda mudi..." class="w-full p-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl text-xs md:text-sm outline-none text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 transition-all font-semibold" autocomplete="off"/>
            
            <div id="search_results_container" class="hidden mt-2 max-h-72 overflow-y-auto border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 rounded-xl p-1.5 divide-y divide-slate-100 dark:divide-slate-800 shadow-2xl z-50 relative">
            </div>
          </div>

          <div class="border-t border-dashed border-slate-200 dark:border-slate-800 my-4 pt-3">
            <span class="text-[10px] uppercase tracking-wider font-bold text-slate-400">Atau Tambah Data Baru</span>
          </div>

          <form id="addUserForm" class="space-y-3">
            <div>
              <label class="block text-[11px] font-semibold text-slate-400 dark:text-slate-400 mb-1">Nama Lengkap</label>
              <input type="text" id="add_nama" placeholder="Nama anak baru..." required class="w-full p-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs outline-none text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 transition-all"/>
            </div>
            
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="block text-[11px] font-semibold text-slate-400 dark:text-slate-400 mb-1">Gender</label>
                <select id="add_gender" required class="w-full p-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs outline-none text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 font-medium">
                  <option value="Laki-laki">Laki-laki</option>
                  <option value="Perempuan">Perempuan</option>
                </select>
              </div>
              <div>
                <label class="block text-[11px] font-semibold text-slate-400 dark:text-slate-400 mb-1">Asal Kelompok</label>
                <select id="add_kelompok" required class="w-full p-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs outline-none text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 transition-all font-medium">
                  <option value="Manukan 2">Manukan 2</option>
                  <option value="Manukan 1">Manukan 1</option>
                  <option value="Candi Lontar">Candi Lontar</option>
                  <option value="Wonorejo">Wonorejo</option>
                </select>
              </div>
            </div>

            <div>
              <label class="block text-[11px] font-semibold text-slate-400 dark:text-slate-400 mb-1">ID Kartu (Opsional)</label>
              <input type="text" id="add_id" placeholder="Misal: USR007" class="w-full p-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs outline-none text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 transition-all"/>
            </div>
            <button type="submit" id="submitBtn" class="w-full p-2.5 bg-emerald-500 hover:bg-emerald-600 text-white font-semibold text-xs rounded-xl shadow-md transition-all">+ Simpan Baru</button>
          </form>
        </div>

        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-4 md:p-6 rounded-2xl shadow-sm">
          <h2 class="text-sm md:text-base font-bold mb-3 border-l-4 border-indigo-500 pl-2.5 text-slate-900 dark:text-white">Target Sebulan (Jumlah Pengajian)</h2>
          <form id="settingsForm" class="space-y-3">
            <div class="flex items-center gap-3">
              <input type="number" id="target_harian" value={targetNgajiPusat} required min="1" class="w-full p-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs outline-none text-slate-900 dark:text-white focus:ring-2 focus:ring-indigo-500 transition-all"/>
              <button type="submit" class="w-auto whitespace-nowrap px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs rounded-xl shadow-md transition-all">Update</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 shadow-sm mb-8">
      
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 mb-4 border-b border-slate-100 dark:border-slate-800">
        <div>
          <h2 class="text-sm md:text-base font-bold border-l-4 border-emerald-500 pl-2.5 text-slate-900 dark:text-white">Daftar Kehadiran & Izin Hari Ini</h2>
          <p id="filterStatusLabel" class="text-xs font-bold text-amber-600 dark:text-amber-400 mt-1 ml-3 hidden">Filter aktif diterapkan</p>
        </div>

        <div class="hidden md:flex items-center gap-3 bg-slate-50 dark:bg-slate-950 p-2 rounded-xl border border-slate-200 dark:border-slate-800 text-xs">
          <span class="font-bold text-slate-400 uppercase tracking-wider text-[10px]">⚡Filter:</span>
          <select id="desktopFilterGender" class="p-1.5 bg-white dark:bg-slate-800 rounded-lg border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white outline-none font-semibold">
            <option value="Semua">Semua Gender</option>
            <option value="Laki-laki">Laki-laki</option>
            <option value="Perempuan">Perempuan</option>
          </select>
          <select id="desktopFilterKelompok" class="p-1.5 bg-white dark:bg-slate-800 rounded-lg border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white outline-none font-semibold">
            <option value="Semua">Semua Kelompok</option>
            <option value="Candi Lontar">Candi Lontar</option>
            <option value="Manukan 1">Manukan 1</option>
            <option value="Manukan 2">Manukan 2</option>
            <option value="Wonorejo">Wonorejo</option>
          </select>
          <button class="btn-clear-filter px-2 py-1 bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-bold rounded-lg hover:bg-rose-500 hover:text-white transition-all">Clear</button>
        </div>

        <div class="block md:hidden w-full">
          <button id="openMobileFilterBtn" class="w-full py-2.5 bg-indigo-50 dark:bg-indigo-950/40 border border-indigo-200 dark:border-indigo-900/60 text-indigo-600 dark:text-indigo-400 rounded-xl text-xs font-bold flex items-center justify-center gap-2 transition-all active:scale-[0.98]">
            🔍 Filter Kelompok / Gender
          </button>
        </div>
      </div>

      <div class="overflow-x-auto w-full rounded-xl border border-slate-100 dark:border-slate-800">
        <table class="w-full text-left border-collapse min-w-[650px]">
          <thead>
            <tr class="bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 text-[11px] font-bold uppercase tracking-wider">
              <th class="p-3.5">ID Kartu</th>
              <th class="p-3.5">Nama</th>
              <th class="p-3.5">Gender</th>
              <th class="p-3.5">Kelompok</th>
              <th class="p-3.5">Status</th>
              <th class="p-3.5">Total Akumulasi</th>
              <th class="p-3.5 text-center">Aksi</th>
            </tr>
          </thead>
          <tbody id="bodyTabelHadir" class="divide-y divide-slate-200 dark:divide-slate-800"></tbody>
        </table>
      </div>
    </div>
  </div>

  <div id="mobileFilterModal" class="fixed inset-0 bg-slate-950/70 backdrop-blur-sm z-[999] opacity-0 pointer-events-none transition-opacity duration-300 flex items-end justify-center">
    <div id="mobileFilterContent" class="w-full bg-white dark:bg-slate-900 rounded-t-3xl p-5 space-y-4 max-w-md border-t border-slate-200 dark:border-slate-800 shadow-2xl transform translate-y-full transition-transform duration-300">
      
      <div class="flex justify-between items-center border-b border-slate-100 dark:border-slate-800 pb-2">
        <div class="flex items-center gap-2">
          <span class="text-sm">⚡</span>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">Filter Kolom</h3>
        </div>
        <button id="closeMobileFilterBtn" class="w-7 h-7 flex items-center justify-center rounded-full bg-slate-100 dark:bg-slate-800 text-xs font-bold text-slate-500 dark:text-slate-400">✕</button>
      </div>

      <div class="space-y-3">
        <div>
          <label class="block text-[11px] font-bold uppercase text-slate-400 mb-1">Pilih Gender</label>
          <select id="mobileFilterGender" class="w-full p-3 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-xs font-semibold rounded-xl text-slate-900 dark:text-white outline-none">
            <option value="Semua">Semua Gender</option>
            <option value="Laki-laki">Hanya Laki-laki</option>
            <option value="Perempuan">Hanya Perempuan</option>
          </select>
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase text-slate-400 mb-1">Pilih Asal Kelompok</label>
          <select id="mobileFilterKelompok" class="w-full p-3 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-xs font-semibold rounded-xl text-slate-900 dark:text-white outline-none">
            <option value="Semua">Semua Kelompok</option>
            <option value="Candi Lontar">Candi Lontar</option>
            <option value="Manukan 1">Manukan 1</option>
            <option value="Manukan 2">Manukan 2</option>
            <option value="Wonorejo">Wonorejo</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-2 pt-2">
        <button class="btn-clear-filter w-full py-2.5 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-xl text-xs font-bold transition-all">Reset</button>
        <button id="applyMobileFilterBtn" class="w-full py-2.5 bg-indigo-600 text-white rounded-xl text-xs font-bold transition-all shadow-md">Terapkan</button>
      </div>
    </div>
  </div>

  <div id="user_db_payload" data-json={JSON.stringify(databaseSemuaUser)}></div>
  <div id="hadir_hari_ini_payload" data-json={JSON.stringify(awalHadirHariIni)}></div>

  <!-- Modal Profil User -->
  <div id="modalProfilUser" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[999] hidden items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 rounded-2xl w-full max-w-sm shadow-2xl border border-slate-200 dark:border-slate-700 overflow-hidden">
      <!-- Header -->
      <div class="bg-indigo-600 p-5 text-white relative">
        <button id="btnTutupProfil" class="absolute top-3 right-3 w-7 h-7 flex items-center justify-center rounded-full bg-white/20 hover:bg-white/30 text-white text-xs font-bold transition-all">✕</button>
        <div id="profilNama" class="text-lg font-extrabold tracking-tight">-</div>
        <div id="profilId" class="text-xs font-mono text-indigo-200 mt-0.5">-</div>
        <div class="flex items-center gap-2 mt-2">
          <span id="profilGenderBadge" class="px-2 py-0.5 bg-white/20 text-white text-[10px] font-bold rounded-full">-</span>
          <span id="profilKelompokBadge" class="px-2 py-0.5 bg-white/20 text-white text-[10px] font-bold rounded-full">-</span>
        </div>
      </div>
      <!-- Stats -->
      <div class="p-5 space-y-4">
        <div class="grid grid-cols-2 gap-3">
          <div class="bg-slate-50 dark:bg-slate-800 rounded-xl p-3 text-center">
            <div id="profilTotalHadir" class="text-2xl font-extrabold text-indigo-600 dark:text-indigo-400">-</div>
            <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mt-0.5">Total Hadir</div>
          </div>
          <div class="bg-slate-50 dark:bg-slate-800 rounded-xl p-3 text-center">
            <div id="profilStatusHariIni" class="text-sm font-extrabold">-</div>
            <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mt-0.5">Status Hari Ini</div>
          </div>
        </div>
        <!-- Progress kehadiran vs target -->
        <div>
          <div class="flex justify-between text-xs font-semibold mb-1.5">
            <span class="text-slate-600 dark:text-slate-400">Capaian vs Target Bulan Ini</span>
            <span id="profilPctLabel" class="text-slate-900 dark:text-white">0%</span>
          </div>
          <div class="bg-slate-200 dark:bg-slate-700 h-2.5 rounded-full overflow-hidden">
            <div id="profilProgressBar" class="bg-indigo-500 h-full rounded-full transition-all duration-500" style="width:0%"></div>
          </div>
          <div id="profilProgressLabel" class="text-[10px] text-slate-400 mt-1">0 / 0 hari</div>
        </div>
        <!-- Link ke dashboard user -->
        <a id="profilLinkDashboard" href="#" target="_blank"
          class="block w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl text-center transition-all shadow-sm">
          Lihat Dashboard Lengkap
        </a>
      </div>
    </div>
  </div>

<script is:inline>
  const htmlEl = document.documentElement;
  const themeToggleBtn = document.getElementById('themeToggleBtn');
  
  if (themeToggleBtn) {
    themeToggleBtn.innerText = htmlEl.classList.contains('dark') ? '🌙' : '☀️';
    themeToggleBtn.addEventListener('click', () => {
      const isDark = htmlEl.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      themeToggleBtn.innerText = isDark ? '🌙' : '☀️';
    });
  }

  window.addEventListener('DOMContentLoaded', () => {
    const dashboardEl = document.getElementById('adminDashboard');
    const API_URL = dashboardEl ? dashboardEl.getAttribute('data-api') : '';

    const databaseMudaMudi = JSON.parse(document.getElementById('user_db_payload')?.getAttribute('data-json') || '[]');
    const masterListHadir = JSON.parse(document.getElementById('hadir_hari_ini_payload')?.getAttribute('data-json') || '[]');

    const deskGender = document.getElementById('desktopFilterGender');
    const deskKelompok = document.getElementById('desktopFilterKelompok');

    const mobModal = document.getElementById('mobileFilterModal');
    const mobContent = document.getElementById('mobileFilterContent');
    const mobGender = document.getElementById('mobileFilterGender');
    const mobKelompok = document.getElementById('mobileFilterKelompok');
    
    const tbodyDesktop = document.getElementById('bodyTabelHadir');
    const tbodyMobile = null;
    const statusLabel = document.getElementById('filterStatusLabel');

    let currentGender = 'Semua';
    let currentKelompok = 'Semua';

    // TRIGGER REFRESH HALAMAN MANUAL
    document.getElementById('btnRefreshHalaman')?.addEventListener('click', () => location.reload());

    // TRIGGER RESET MASSAL
    document.getElementById('btnResetMassalHariIni')?.addEventListener('click', () => {
      if (confirm("⚠️ PERINGATAN MASAL:\n\nApakah Anda yakin ingin MENGOSONGKAN daftar kehadiran & izin hari ini?")) {
        if (confirm("Sekali lagi, pastikan sesi absensi kelas memang sudah selesai. Kosongkan sekarang?")) {
          triggerAPI({ action: 'clear_all_hari_ini' });
        }
      }
    });

    // TRIGGER KIRIM WA
    document.getElementById('btnKirimWA')?.addEventListener('click', () => {
      if(masterListHadir.length === 0) return alert("Belum ada data kehadiran/izin hari ini!");
      const waText = generateWASummary();
      window.open(`https://wa.me/?text=${waText}`, '_blank');
    });

    // FUNGSI GENERATE TEKS WA - WITH PERCENTAGE PER KELOMPOK
    function generateWASummary() {
      const today = new Date().toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
      
      const totalMudaMudi = databaseMudaMudi.length;
      const totalHadir = masterListHadir.filter(u => u.Status === 'Hadir').length;
      const totalIzin = masterListHadir.filter(u => u.Status === 'Izin').length;
      const totalTidakHadir = totalMudaMudi - totalHadir - totalIzin;
      
      const pctHadir = totalMudaMudi > 0 ? Math.round((totalHadir / totalMudaMudi) * 100) : 0;
      const pctIzin = totalMudaMudi > 0 ? Math.round((totalIzin / totalMudaMudi) * 100) : 0;
      const pctTidakHadir = totalMudaMudi > 0 ? Math.round((totalTidakHadir / totalMudaMudi) * 100) : 0;

      const kelompokStats = {};
      databaseMudaMudi.forEach(u => {
        const k = u.kelompok || 'Lainnya';
        if (!kelompokStats[k]) kelompokStats[k] = { total: 0, hadir: 0, izin: 0 };
        kelompokStats[k].total++;
      });

      masterListHadir.forEach(u => {
        const k = u.Kelompok || 'Lainnya';
        if (!kelompokStats[k]) kelompokStats[k] = { total: 0, hadir: 0, izin: 0 };
        if (u.Status === 'Hadir') kelompokStats[k].hadir++;
        else if (u.Status === 'Izin') kelompokStats[k].izin++;
      });

      const sortedData = [...masterListHadir].sort((a,b) => {
        if(a.Kelompok !== b.Kelompok) return a.Kelompok.localeCompare(b.Kelompok);
        return a.Gender.localeCompare(b.Gender);
      });

      const kelompokMap = {};
      sortedData.forEach(u => {
        if(u.Status !== 'Hadir') return;
        const k = u.Kelompok || 'Lainnya';
        if(!kelompokMap[k]) kelompokMap[k] = { 'Laki-laki': [], 'Perempuan': [] };
        const g = u.Gender || 'Laki-laki';
        kelompokMap[k][g].push(u.Nama);
      });

      let text = `*REKAP ABSENSI PENGAJIAN*\n`;
      text += `🗓️ Hari/Tanggal: ${today}\n\n`;

      text += `📊 *RINGKASAN KESELURUHAN:*\n`;
      text += `Total Muda Mudi: ${totalMudaMudi} orang\n`;
      text += `✅ Hadir: ${totalHadir} orang (${pctHadir}%)\n`;
      text += `📝 Izin: ${totalIzin} orang (${pctIzin}%)\n`;
      text += `❌ Tidak Hadir: ${totalTidakHadir} orang (${pctTidakHadir}%)\n\n`;

      let noKel = 1;
      for (const k in kelompokMap) {
        const stats = kelompokStats[k] || { total: 0, hadir: 0, izin: 0 };
        const pctKelompok = stats.total > 0 ? Math.round((stats.hadir / stats.total) * 100) : 0;

        text += `*KELOMPOK ${noKel}. ${k}*\n`;
        text += `📈 Kehadiran: ${stats.hadir}/${stats.total} (${pctKelompok}%)\n\n`;

        text += `Laki-laki :\n`;
        if (kelompokMap[k]['Laki-laki'].length > 0) {
          kelompokMap[k]['Laki-laki'].forEach((nama, i) => text += `${i+1}. ${nama}\n`);
        } else {
          text += `-\n`;
        }

        text += `\nPerempuan :\n`;
        if (kelompokMap[k]['Perempuan'].length > 0) {
          kelompokMap[k]['Perempuan'].forEach((nama, i) => text += `${i+1}. ${nama}\n`);
        } else {
          text += `-\n`;
        }
        text += `\n`;
        noKel++;
      }

      const listIzin = masterListHadir.filter(u => u.Status === 'Izin');
      if (listIzin.length > 0) {
        text += `*LIST IZIN (${listIzin.length} Orang):*\n`;
        listIzin.forEach((u, i) => text += `${i+1}. ${u.Nama} (${u.Kelompok})\n`);
        text += `\n`;
      }

      text += `─────────────────\n`;
      text += `Total Hadir Fisik: ${totalHadir} Orang.`;

      return encodeURIComponent(text);
    }

    function jalankanExcelFilter() {
      if (window.innerWidth >= 768) {
        currentGender = deskGender.value;
        currentKelompok = deskKelompok.value;
        mobGender.value = currentGender;
        mobKelompok.value = currentKelompok;
      } else {
        currentGender = mobGender.value;
        currentKelompok = mobKelompok.value;
        deskGender.value = currentGender;
        deskKelompok.value = currentKelompok;
      }

      if (currentGender !== 'Semua' || currentKelompok !== 'Semua') {
        statusLabel?.classList.remove('hidden');
        statusLabel.innerText = `⚠️ Filter: ${currentGender !== 'Semua' ? currentGender : ''} ${currentKelompok !== 'Semua' ? '['+currentKelompok+']' : ''}`;
      } else {
        statusLabel?.classList.add('hidden');
      }

      const dataTerfilter = masterListHadir.filter(item => {
        const cocokGender = (currentGender === 'Semua' || item.Gender === currentGender);
        const cocokKelompok = (currentKelompok === 'Semua' || item.Kelompok === currentKelompok);
        return cocokGender && cocokKelompok;
      });

      if (dataTerfilter.length === 0) {
        if (tbodyDesktop) tbodyDesktop.innerHTML = `<tr><td colspan="7" class="p-8 text-center text-xs text-slate-400">Tidak ada data jemaah yang cocok.</td></tr>`;
        return;
      }

      // 1. RENDER DESKTOP VIEW
      if (tbodyDesktop) {
        tbodyDesktop.innerHTML = dataTerfilter.map(u => {
          const isIzin = u.Status === 'Izin';
          const statusBadge = isIzin 
            ? `<span class="inline-block px-2 py-0.5 text-[10px] font-bold rounded-md bg-amber-500/10 text-amber-500">Izin</span>`
            : `<span class="inline-block px-2 py-0.5 text-[10px] font-bold rounded-md bg-emerald-500/10 text-emerald-500">Hadir</span>`;
          
          const cancelBtnClass = isIzin ? 'bg-amber-500/10 hover:bg-amber-500 hover:text-white text-amber-500' : 'bg-rose-500/10 hover:bg-rose-500 hover:text-white text-rose-500';
          const cancelBtnText = isIzin ? '❌ Batal Izin' : '❌ Batal Hadir';

          return `
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors text-xs text-slate-700 dark:text-slate-300">
            <td class="p-3.5 font-mono font-bold text-purple-600 dark:text-purple-400">${u.ID_User}</td>
            <td class="p-3.5 font-semibold text-slate-900 dark:text-white">${u.Nama}</td>
            <td class="p-3.5"><span class="inline-block px-2 py-0.5 text-[10px] font-bold rounded-md ${u.Gender === 'Perempuan' ? 'bg-pink-500/10 text-pink-500' : 'bg-blue-500/10 text-blue-500'}">${u.Gender}</span></td>
            <td class="p-3.5 text-indigo-600 dark:text-indigo-400 font-bold">${u.Kelompok}</td>
            <td class="p-3.5">${statusBadge}</td>
            <td class="p-4 font-medium">${u.Total_Hadir} Hari</td>
            <td class="p-3.5 text-center">
              <button data-id="${u.ID_User}" data-status="${u.Status}" class="btn-batal-absen px-2.5 py-1 ${cancelBtnClass} rounded-lg text-[11px] font-bold transition-all">${cancelBtnText}</button>
            </td>
          </tr>
        `}).join('');
      }

      // Re-attach Event Button Batal
      document.querySelectorAll('.btn-batal-absen').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const idUser = e.currentTarget.getAttribute('data-id');
          const status = e.currentTarget.getAttribute('data-status');
          const msg = status === 'Izin' ? 'Batalkan status izin muda mudi ini?' : 'Batalkan kehadiran muda mudi ini?';
          if(confirm(msg)) {
            triggerAPI({ action: 'hapus_absen', id_user: idUser });
          }
        });
      });
    }

    // CONTROLLERS MODAL POP-UP MOBILE
    function openModalFilter() {
      mobModal.classList.remove('pointer-events-none', 'opacity-0');
      mobContent.classList.remove('translate-y-full');
    }

    function closeModalFilter() {
      mobModal.classList.add('pointer-events-none', 'opacity-0');
      mobContent.classList.add('translate-y-full');
    }

    document.getElementById('openMobileFilterBtn')?.addEventListener('click', openModalFilter);
    document.getElementById('closeMobileFilterBtn')?.addEventListener('click', closeModalFilter);
    
    mobModal?.addEventListener('click', (e) => {
      if (e.target === mobModal) closeModalFilter();
    });

    document.getElementById('applyMobileFilterBtn')?.addEventListener('click', () => {
      jalankanExcelFilter();
      closeModalFilter();
    });

    deskGender?.addEventListener('change', jalankanExcelFilter);
    deskKelompok?.addEventListener('change', jalankanExcelFilter);

    document.querySelectorAll('.btn-clear-filter').forEach(btn => {
      btn.addEventListener('click', () => {
        if(deskGender) deskGender.value = 'Semua';
        if(deskKelompok) deskKelompok.value = 'Semua';
        if(mobGender) mobGender.value = 'Semua';
        if(mobKelompok) mobKelompok.value = 'Semua';
        jalankanExcelFilter();
        closeModalFilter();
      });
    });

    jalankanExcelFilter();

    // MEKANISME API INTERACTION
    async function triggerAPI(payload) {
      if (!API_URL) return alert("API URL tidak ditemukan!");
      
      try {
        const bodyQuery = [];
        for (const key in payload) bodyQuery.push(encodeURIComponent(key) + '=' + encodeURIComponent(payload[key]));
        await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: bodyQuery.join('&')
        });
        location.reload();
      } catch (err) {
        location.reload();
      }
    }

    // ==========================================
    // 🔥 LIVE SEARCH - TAMPILAN BARU (USER FRIENDLY)
    // ==========================================
    const searchInput = document.getElementById('search_nama');
    const resultsContainer = document.getElementById('search_results_container');

    // Fungsi untuk highlight text yang cocok dengan keyword
    function highlightText(text, keyword) {
      if (!keyword) return text;
      const regex = new RegExp(`(${keyword.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
      return text.replace(regex, '<span class="highlight-match">$1</span>');
    }

    searchInput?.addEventListener('input', (e) => {
      const keyword = e.target.value.toLowerCase().trim();
      if (!keyword) { 
        resultsContainer.classList.add('hidden'); 
        return; 
      }
      
      const filtered = databaseMudaMudi.filter(item => 
        item.nama.toLowerCase().includes(keyword) || 
        item.id.toLowerCase().includes(keyword)
      );

      if (filtered.length === 0) {
        resultsContainer.innerHTML = `
          <div class="p-4 text-center">
            <div class="text-2xl mb-1">🔍</div>
            <div class="text-xs text-slate-400 font-semibold">Nama tidak ditemukan</div>
          </div>`;
        resultsContainer.classList.remove('hidden');
        return;
      }

      // Info jumlah hasil
      const countInfo = `<div class="px-2 py-1.5 text-[10px] font-bold uppercase tracking-wider text-slate-400 border-b border-slate-100 dark:border-slate-800">Ditemukan ${filtered.length} orang</div>`;

      resultsContainer.innerHTML = countInfo + filtered.map(item => {
        const sudahHadir = item.status === 'Hadir';
        const sudahIzin = item.status === 'Izin';

        // Badge status saat ini
        let statusBadge = '';
        if (sudahHadir) {
          statusBadge = `<span class="inline-block px-1.5 py-0.5 text-[9px] font-bold rounded bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">✓ Sudah Hadir</span>`;
        } else if (sudahIzin) {
          statusBadge = `<span class="inline-block px-1.5 py-0.5 text-[9px] font-bold rounded bg-amber-500/15 text-amber-600 dark:text-amber-400 uppercase tracking-wider">📝 Sudah Izin</span>`;
        } else {
          statusBadge = `<span class="inline-block px-1.5 py-0.5 text-[9px] font-bold rounded bg-slate-500/15 text-slate-500 dark:text-slate-400 uppercase tracking-wider">Belum Absen</span>`;
        }

        // Highlight nama yang di-search
        const highlightedName = highlightText(item.nama, keyword);
        const highlightedId = highlightText(item.id, keyword);

        return `
          <div class="p-2.5 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors rounded-lg my-1">
            <div class="flex items-start justify-between gap-2">
              <div class="flex-1 min-w-0">
                <div class="text-sm font-bold text-slate-900 dark:text-white leading-tight">${highlightedName}</div>
                <div class="flex items-center gap-1.5 mt-1 flex-wrap">
                  <span class="text-[10px] font-mono text-purple-500 dark:text-purple-400 font-semibold">${highlightedId}</span>
                  <span class="text-slate-300 dark:text-slate-600">•</span>
                  <span class="text-[10px] font-semibold text-indigo-600 dark:text-indigo-400">${item.kelompok || '-'}</span>
                  <span class="text-slate-300 dark:text-slate-600">•</span>
                  ${statusBadge}
                </div>
              </div>
              <div class="flex flex-col gap-1 shrink-0">
                <button type="button" data-id-absen="${item.id}" data-action="absen" class="btn-quick-absen text-[11px] font-bold px-3 py-1.5 rounded-lg transition-all ${sudahHadir ? 'bg-emerald-500/10 text-emerald-500 cursor-not-allowed opacity-60' : 'bg-emerald-500 hover:bg-emerald-600 text-white shadow-sm hover:shadow'}" ${sudahHadir ? 'disabled' : ''}>
                  ${sudahHadir ? '✓ Hadir' : '✓ Hadir'}
                </button>
                <button type="button" data-id-absen="${item.id}" data-action="izin" class="btn-quick-absen text-[11px] font-bold px-3 py-1.5 rounded-lg transition-all ${sudahIzin ? 'bg-amber-500/10 text-amber-500 cursor-not-allowed opacity-60' : 'bg-amber-500 hover:bg-amber-600 text-white shadow-sm hover:shadow'}" ${sudahIzin ? 'disabled' : ''}>
                  ${sudahIzin ? '📝 Izin' : '📝 Izin'}
                </button>
                <button type="button" onclick="bukaProfilUser('${item.id}')" class="text-[11px] font-bold px-3 py-1.5 rounded-lg bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 hover:bg-indigo-500 hover:text-white transition-all">
                  Profil
                </button>
              </div>
            </div>
          </div>`;
      }).join('');
      
      resultsContainer.classList.remove('hidden');
    });

    resultsContainer?.addEventListener('click', async (e) => {
      const targetBtn = e.target.closest('.btn-quick-absen');
      if (!targetBtn) return;
      const idUser = targetBtn.getAttribute('data-id-absen');
      const action = targetBtn.getAttribute('data-action') || 'absen';
      if(idUser) {
        resultsContainer.classList.add('hidden');
        await triggerAPI({ action: action, id_user: idUser });
      }
    });

    document.addEventListener('click', (e) => {
      if (!searchInput?.contains(e.target) && !resultsContainer?.contains(e.target)) {
        resultsContainer?.classList.add('hidden');
      }
    });

    // FORM DAFTARKAN ANAK BARU
    document.getElementById('addUserForm')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const inputNama = document.getElementById('add_nama').value.trim();
      const inputGender = document.getElementById('add_gender').value;
      const inputKelompok = document.getElementById('add_kelompok').value;
      let inputId = document.getElementById('add_id').value.trim() || ("USR" + Math.floor(Math.random() * 9000 + 1000));

      triggerAPI({ action: 'tambah_user', nama: inputNama, gender: inputGender, kelompok: inputKelompok, id_user: inputId });
    });

    // UPDATE TARGET BULANAN
    document.getElementById('settingsForm')?.addEventListener('submit', (e) => {
      e.preventDefault();
      triggerAPI({ action: 'update_settings', target_harian: document.getElementById('target_harian').value });
    });

    // QR SCANNER OTOMATIS
    if (document.getElementById('reader')) {
      const html5QrcodeScanner = new Html5QrcodeScanner("reader", { 
        fps: 24, 
        qrbox: function(w, h) { return { width: Math.floor(Math.min(w, h) * 0.75), height: Math.floor(Math.min(w, h) * 0.75) }; },
        rememberLastUsedCamera: true, 
        supportedScanTypes: [Html5QrcodeScanType.SCAN_TYPE_CAMERA]
      });
      html5QrcodeScanner.render(async (decodedText) => {
        html5QrcodeScanner.clear(); 
        await triggerAPI({ action: 'absen', id_user: decodedText.trim() });
      }, () => {});
    }

    // ==========================================
    // MODAL PROFIL USER
    // ==========================================
    const modalProfil = document.getElementById('modalProfilUser');

    function bukaProfilUser(userId) {
      const user = databaseMudaMudi.find(u => u.id === userId);
      if (!user) return;

      // Cari data hadir dari masterListHadir
      const hadirData = masterListHadir.find(u => u.ID_User === userId);
      const totalHadir = hadirData ? hadirData.Total_Hadir : (user.total_hadir || 0);
      const statusHariIni = user.status || 'Belum Hadir';

      // target dari halaman (ambil dari input target)
      const targetBulan = parseInt(document.getElementById('target_harian')?.value || '2') || 2;
      const pct = Math.min(100, Math.round((totalHadir / targetBulan) * 100));

      document.getElementById('profilNama').textContent = user.nama || '-';
      document.getElementById('profilId').textContent = 'ID: ' + (user.id || '-');
      document.getElementById('profilGenderBadge').textContent = user.gender || '-';
      document.getElementById('profilKelompokBadge').textContent = user.kelompok || '-';
      document.getElementById('profilTotalHadir').textContent = totalHadir + ' Hari';

      const statusEl = document.getElementById('profilStatusHariIni');
      if (statusHariIni === 'Hadir') {
        statusEl.textContent = '✓ Hadir';
        statusEl.className = 'text-sm font-extrabold text-emerald-500';
      } else if (statusHariIni === 'Izin') {
        statusEl.textContent = '📝 Izin';
        statusEl.className = 'text-sm font-extrabold text-amber-500';
      } else {
        statusEl.textContent = '— Belum';
        statusEl.className = 'text-sm font-extrabold text-slate-400';
      }

      document.getElementById('profilPctLabel').textContent = pct + '%';
      document.getElementById('profilProgressBar').style.width = pct + '%';
      document.getElementById('profilProgressLabel').textContent = totalHadir + ' / ' + targetBulan + ' hari';

      const linkDashboard = document.getElementById('profilLinkDashboard');
      linkDashboard.href = '/user/dashboard?id=' + encodeURIComponent(user.id) + '&nama=' + encodeURIComponent(user.nama);

      modalProfil.classList.remove('hidden');
      modalProfil.classList.add('flex');
    }

    document.getElementById('btnTutupProfil')?.addEventListener('click', () => {
      modalProfil.classList.add('hidden');
      modalProfil.classList.remove('flex');
    });
    modalProfil?.addEventListener('click', (e) => {
      if (e.target === modalProfil) {
        modalProfil.classList.add('hidden');
        modalProfil.classList.remove('flex');
      }
    });

    window.bukaProfilUser = bukaProfilUser;
  });
</script>
</body>
</html>